# ==============================================================================
# SRI TIRUMALA DRY FRUITS - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Purpose: High-availability live customer orders, POS transactions, real money
# CRITICAL: NEVER COMMIT REAL PRODUCTION VALUES TO REPOSITORY SOURCE CONTROL!
# Inject values via GitHub Actions Secrets, HashiCorp Vault, AWS Secrets Manager,
# or encrypted server environment variables.
# ==============================================================================

# Core Application Server
NODE_ENV=production
PORT=3000
TZ=Asia/Kolkata
SITE_URL=https://sritirumaladryfruits.com

# Security Secrets (High-entropy 64-character cryptographic hex strings)
# Generate securely via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# In production, the server will FAIL TO START if secrets are missing or default.
SESSION_SECRET=replace_with_prod_64_char_cryptographic_hex_secret
COOKIE_SECRET=replace_with_prod_64_char_cryptographic_hex_secret
OTP_SECRET=replace_with_prod_32_char_cryptographic_hex_secret

# WhatsApp Storefront Configuration (Live Store Business Phone)
STORE_WHATSAPP_PHONE=919133133931
FREE_DELIVERY_THRESHOLD=500
DELIVERY_CHARGE=50

# Meta WhatsApp Cloud API (Production Permanent System User Token)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_production_system_user_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_production_phone_number_id
WHATSAPP_OTP_TEMPLATE=auth_otp_code
WHATSAPP_VERIFY_TOKEN=replace_with_meta_production_verify_token
WHATSAPP_APP_SECRET=replace_with_meta_production_app_secret

# Production Transactional Mail Relay (e.g. AWS SES / SendGrid)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=replace_with_aws_ses_smtp_username
SMTP_PASS=replace_with_aws_ses_smtp_password

# Observability & Production Monitoring
LOG_LEVEL=info
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.prod.internal:4318

# Offsite Backup Sync
BACKUP_S3_BUCKET=sri-tirumala-backups-prod
BACKUP_RETENTION_DAYS=90
