<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> - Sri Tirumala Dryfruits</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="/storefront.css">
  <style>
    body {
      background-color: var(--sf-cream);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .wishlist-card {
      border-radius: 16px;
      border: 1px solid var(--sf-border);
      background: #ffffff;
      box-shadow: 0 4px 16px rgba(6, 58, 34, 0.05);
      transition: var(--sf-transition);
    }
    .wishlist-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--sf-shadow-md);
    }
  </style>
</head>
<body>
  <%- include('partials/header_account') %>

  <div class="container mt-4 mb-5">
    <div class="row">
      <div class="col-md-3 mb-4 mb-md-0">
        <%- include('partials/account_nav', { currentPath: '/account/wishlist' }) %>
      </div>
      
      <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h4 class="brand-font mb-1" style="color: var(--brand-green);">My Saved Wishlist</h4>
            <small class="text-muted" id="wishlistPageCounter">Your saved favorite items</small>
          </div>
          <button type="button" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" id="clearAllWishlistBtn" onclick="clearFullWishlist()" style="display: none; border-radius: 20px;">
            <span class="material-symbols-outlined" style="font-size: 1rem;">delete_sweep</span> Clear All
          </button>
        </div>

        <!-- Dynamic Container Rendered from localStorage -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="wishlistGrid">
          <!-- Injected via client script -->
        </div>

        <!-- Empty Wishlist State -->
        <div id="wishlistEmptyState" class="text-center py-5" style="display: none;">
          <div class="p-5 border rounded-3 bg-white shadow-sm" style="border-radius: 20px !important;">
            <span class="material-symbols-outlined d-block mb-3" style="font-size: 3rem; color: #D89A4E;">favorite_border</span>
            <h5 class="fw-bold text-dark">Your wishlist is currently empty</h5>
            <p class="text-muted small max-w-600 mx-auto mb-4">
              Explore our premium organic dry fruits, nutritious millets, and spices, and tap the heart icon on any product to save it here for later.
            </p>
            <a href="/" class="btn btn-brand px-4 py-2 fw-bold d-inline-flex align-items-center gap-1" style="border-radius: 20px;">
              <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">shopping_bag</span> Discover Products
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/storefront.js"></script>
  <script>
    function renderWishlistPage() {
      const container = document.getElementById('wishlistGrid');
      const emptyState = document.getElementById('wishlistEmptyState');
      const counter = document.getElementById('wishlistPageCounter');
      const clearBtn = document.getElementById('clearAllWishlistBtn');
      if (!container) return;

      let wishlist = [];
      try {
        wishlist = JSON.parse(localStorage.getItem('stdf_wishlist') || '[]');
      } catch (e) {
        wishlist = [];
      }

      container.innerHTML = '';

      if (wishlist.length === 0) {
        container.style.display = 'none';
        if (emptyState) emptyState.style.display = 'block';
        if (clearBtn) clearBtn.style.display = 'none';
        if (counter) counter.innerText = '0 items saved';
        return;
      }

      container.style.display = 'flex';
      if (emptyState) emptyState.style.display = 'none';
      if (clearBtn) clearBtn.style.display = 'inline-block';
      if (counter) counter.innerText = `${wishlist.length} item${wishlist.length > 1 ? 's' : ''} saved`;

      wishlist.forEach(item => {
        const col = document.createElement('div');
        col.className = 'col';
        col.innerHTML = `
          <div class="wishlist-card p-3 h-100 d-flex flex-column">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="position-relative rounded-3 overflow-hidden d-flex align-items-center justify-content-center bg-light" 
                   style="width: 70px; height: 70px; flex-shrink: 0;">
                ${item.image ? `<img src="${item.image}" alt="${item.name}" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none';">` : ''}
                <span class="material-symbols-outlined" style="font-size: 2rem; color: var(--brand-gold);">spa</span>
              </div>
              <div class="overflow-hidden flex-grow-1">
                <span class="badge bg-light text-muted border small mb-1">${item.category || 'Dry Fruits'}</span>
                <h6 class="fw-bold text-dark text-truncate m-0" title="${item.name}">${item.name}</h6>
                <div class="fw-bold fs-6 mt-1" style="color: var(--brand-green-light);">₹${Number(item.price).toFixed(2)}</div>
              </div>
            </div>

            <div class="mt-auto d-flex flex-column gap-2">
              <button class="btn btn-brand w-100 btn-sm py-2 fw-bold d-inline-flex align-items-center justify-content-center gap-1" onclick="moveItemToCart(${item.id}, '${item.name.replace(/'/g, "\\'")}', ${item.price})">
                <span class="material-symbols-outlined" style="font-size: 1.05rem;">shopping_bag</span> Move to Cart
              </button>
              <div class="d-flex gap-2">
                <button class="btn btn-outline-success btn-sm flex-grow-1 fw-bold d-inline-flex align-items-center justify-content-center gap-1" onclick="window.Storefront && window.Storefront.orderProductViaWhatsApp({ id: ${item.id}, name: '${item.name.replace(/'/g, "\\'")}', price: ${item.price}, category: '${item.category || ''}' })">
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </button>
                <button class="btn btn-outline-danger btn-sm px-2 d-inline-flex align-items-center justify-content-center" onclick="removeItemFromWishlist(${item.id})" title="Remove item">
                  <span class="material-symbols-outlined" style="font-size: 1rem;">delete</span>
                </button>
              </div>
            </div>
          </div>
        `;
        container.appendChild(col);
      });
    }

    async function moveItemToCart(id, name, price) {
      if (window.Storefront) {
        await window.Storefront.addToCart(id, 1, name);
        removeItemFromWishlist(id);
      }
    }

    function removeItemFromWishlist(id) {
      if (window.Storefront) {
        window.Storefront.toggleWishlist({ id: id });
        renderWishlistPage();
      }
    }

    function clearFullWishlist() {
      if (confirm('Are you sure you want to clear all items in your wishlist?')) {
        localStorage.removeItem('stdf_wishlist');
        if (window.Storefront) {
          window.Storefront.renderWishlist();
          window.Storefront.syncWishlistButtons();
        }
        renderWishlistPage();
      }
    }

    document.addEventListener('DOMContentLoaded', renderWishlistPage);
  </script>
</body>
</html>
