<%- include('header') %>

<% if (locals.activeCategory && activeCategory !== 'All') { %>
<!-- ==============================================================================
     CATEGORY BREADCRUMB & COLLECTION HERO
     ============================================================================== -->
<section class="category-breadcrumb-section py-4 border-bottom no-print" style="background: linear-gradient(135deg, #FAF8F5 0%, #EDEAE1 100%); border-color: var(--sf-border, #EBE7DF) !important;">
    <div class="max-w-7xl mx-auto px-3">
        <%- include('partials/breadcrumbs', { breadcrumbs: locals.breadcrumbs || [
            { name: 'Home', url: '/' },
            { name: activeCategory, current: true }
        ] }) %>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="font-label-caps text-gold font-bold">Tekkali Storefront Collection</span>
                <h1 class="font-display-hero text-primary font-bold m-0" style="font-size: clamp(26px, 3.2vw, 42px);">
                    Buy Premium <%= activeCategory %> Online
                </h1>
                <p class="font-body-md text-muted mt-2 mb-0" style="max-width: 650px;">
                    Order 100% genuine, hand-sorted <%= activeCategory.toLowerCase() %> direct from Sri Tirumala Dryfruits, Opposite RTC Complex, Tekkali. Fast local and regional dispatch.
                </p>
            </div>
            <div class="badge bg-white text-dark border px-3 py-2 font-label-md shadow-sm align-self-start align-self-md-auto" style="border-radius: 12px;">
                <%= products ? products.length : 0 %> Items in <%= activeCategory %>
            </div>
        </div>
    </div>
</section>
<% } %>

<% if (!locals.activeCategory || activeCategory === 'All') { %>
<!-- ==============================================================================
     1. CINEMATIC SCROLL STORYTELLING STAGE (Hailuo AI Film Asset)
     ============================================================================== -->
<section class="cinematic-scroll-track no-print" id="cinematic-experience" aria-label="Cinematic Dry Fruits Experience">
    <div class="cinematic-sticky-stage">
        <!-- Live Video Element Controlled by Scroll Position -->
        <div class="cinematic-video-canvas">
            <video id="cinematic-video"
                   poster="/videos/cinematic-poster.jpg"
                   preload="auto"
                   muted
                   playsinline
                   webkit-playsinline
                   aria-hidden="true">
                <source src="/videos/cinematic-story-720p.mp4" media="(max-width: 768px)" type="video/mp4">
                <source src="/videos/cinematic-story.mp4" type="video/mp4">
            </video>
        </div>

        <!-- Fallback Keyframe Background (Active if video encounters any issue or in reduced-motion) -->
        <div id="cinematic-fallback-bg" class="cinematic-fallback-bg" aria-hidden="true"></div>

        <!-- Atmospheric Cinematic Lighting & Gradient Overlays -->
        <div class="cinematic-lighting-overlay" aria-hidden="true"></div>
        <div class="cinematic-ambient-bloom" aria-hidden="true"></div>

        <!-- Narrative Content Overlays (Masked Line Reveals, Staggered Hierarchy) -->
        <div class="cinematic-content-container">
            <!-- CHAPTER ONE — THE FLOATING-FRUIT OPENING -->
            <div class="cinematic-chapter active" id="cinematic-chapter-1">
                <div class="cinematic-eyebrow">THE ART OF GOODNESS</div>
                <h1 class="cinematic-headline">
                    <span class="reveal-line-wrap"><span class="reveal-line">Nature's finest,</span></span>
                    <span class="reveal-line-wrap"><span class="reveal-line italic-serif">brought closer.</span></span>
                </h1>
                <p class="cinematic-description">
                    Discover a world of nuts and dried fruits, thoughtfully chosen for everyday enjoyment.
                </p>
                <div class="cinematic-cta-group">
                    <a href="#product-categories" class="btn-cinema-gold">
                        <span>Explore Our Collection</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                    <a href="#brand-story" class="btn-cinema-secondary">
                        <span class="material-symbols-outlined text-sm">auto_stories</span>
                        <span>Discover Our Story</span>
                    </a>
                </div>
            </div>

            <!-- CHAPTER TWO — THE PRODUCT REVEAL -->
            <div class="cinematic-chapter" id="cinematic-chapter-2">
                <div class="cinematic-eyebrow">QUALITY IN EVERY DETAIL</div>
                <h2 class="cinematic-headline">
                    <span class="reveal-line-wrap"><span class="reveal-line">Every handful</span></span>
                    <span class="reveal-line-wrap"><span class="reveal-line italic-serif">tells a story.</span></span>
                </h2>
                <p class="cinematic-description">
                    From familiar favourites to delightful discoveries, find the dry fruits that belong in your everyday moments.
                </p>
                <div class="cinematic-feature-chips">
                    <span class="cinematic-chip">
                        <span class="material-symbols-outlined chip-symbol" style="font-size: 13px; color: var(--gold-caramel); vertical-align: middle;">verified</span> Hand-Cleaned &amp; Graded
                    </span>
                    <span class="cinematic-chip">
                        <span class="material-symbols-outlined chip-symbol" style="font-size: 13px; color: var(--gold-caramel); vertical-align: middle;">verified</span> Top Brand Selections
                    </span>
                    <span class="cinematic-chip">
                        <span class="material-symbols-outlined chip-symbol" style="font-size: 13px; color: var(--gold-caramel); vertical-align: middle;">verified</span> Rich in Natural Healthy Oils
                    </span>
                </div>
                <div class="cinematic-cta-group">
                    <a href="#featured-spotlight" class="btn-cinema-gold">
                        <span>Discover Bestsellers</span>
                        <span class="material-symbols-outlined text-sm">star</span>
                    </a>
                    <a href="#brand-story" class="btn-cinema-secondary">
                        <span>Our Brands &amp; Quality</span>
                    </a>
                </div>
            </div>

            <!-- CHAPTER THREE — ABUNDANCE AND THE FINAL REVEAL -->
            <div class="cinematic-chapter" id="cinematic-chapter-3">
                <div class="cinematic-eyebrow">MADE FOR YOUR EVERYDAY MOMENTS</div>
                <h2 class="cinematic-headline">
                    <span class="reveal-line-wrap"><span class="reveal-line">Goodness worth</span></span>
                    <span class="reveal-line-wrap"><span class="reveal-line italic-serif">sharing.</span></span>
                </h2>
                <p class="cinematic-description">
                    Bring a little natural richness to everyday routines, thoughtful gifts, and moments around the table.
                </p>
                <div class="cinematic-cta-group">
                    <a href="#catalog-section" class="btn-cinema-gold">
                        <span>Shop Our Collection</span>
                        <span class="material-symbols-outlined text-sm">shopping_bag</span>
                    </a>
                    <a href="https://wa.me/918945244184?text=Hello%20Sri%20Tirumala%20Dryfruits,%20I%20would%20like%20to%20order%20premium%20dry%20fruits." 
                       target="_blank" 
                       rel="noopener noreferrer" 
                       class="btn-cinema-whatsapp">
                        <span>Order on WhatsApp</span>
                        <span class="material-symbols-outlined text-sm">chat</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Cinematic Story HUD (Timeline Dots, Scrub Progress & Controls) -->
        <div class="cinematic-hud" aria-label="Story chapters navigation">
            <div class="hud-chapter-dots" role="tablist">
                <button type="button" class="hud-dot-btn active" data-chapter-target="1" aria-label="Jump to Chapter 1: The Harvest">
                    <span class="hud-dot-indicator"></span>
                    <span class="hud-dot-label">01 Harvest</span>
                </button>
                <button type="button" class="hud-dot-btn" data-chapter-target="2" aria-label="Jump to Chapter 2: Quality Selection">
                    <span class="hud-dot-indicator"></span>
                    <span class="hud-dot-label">02 Selection</span>
                </button>
                <button type="button" class="hud-dot-btn" data-chapter-target="3" aria-label="Jump to Chapter 3: Abundance">
                    <span class="hud-dot-indicator"></span>
                    <span class="hud-dot-label">03 Abundance</span>
                </button>
            </div>
        </div>
    </div>
</section>

