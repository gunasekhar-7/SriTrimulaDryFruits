<!-- ==============================================================================
     8. CLIENT-SIDE INTERACTION SCRIPT
     ============================================================================== -->
<script>
    // Stitch Toast Feedback Controller
    window.dismissToast = function () {
        const toast = document.getElementById('cartToast');
        if (toast) {
            toast.classList.remove('translate-y-visible');
            toast.classList.add('translate-y-hidden');
        }
    };

    window.showRoyalCasketToast = function (productName, amount) {
        const toast = document.getElementById('cartToast');
        const nameEl = document.getElementById('toastProductName');
        const amountEl = document.getElementById('toastAddedAmount');
        if (toast && nameEl) {
            nameEl.innerText = productName;
            if (amountEl && amount) amountEl.innerText = '₹' + amount + ' added';
            toast.classList.remove('translate-y-hidden');
            toast.classList.add('translate-y-visible');

            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(() => {
                window.dismissToast();
            }, 4500);
        }
    };

    // Quick Add for Featured Spotlight Items
    window.quickAddFeaturedItem = function (itemName, price) {
        window.showRoyalCasketToast(itemName, price);
        // Dispatch to cart store if available
        const cartBadge = document.getElementById('cartCountBadge');
        if (cartBadge) {
            const current = parseInt(cartBadge.innerText || '0', 10);
            cartBadge.innerText = (current + 1).toString();
            cartBadge.style.display = 'inline-block';
        }
        const mobileBadge = document.getElementById('mobileCartBadge');
        if (mobileBadge) {
            const current = parseInt(mobileBadge.innerText || '0', 10);
            mobileBadge.innerText = (current + 1).toString();
            mobileBadge.style.display = 'inline-block';
        }
    };

    // 1-Click WhatsApp Direct Order
    window.orderWhatsAppDirect = function (itemName, price) {
        const phone = '919133133931';
        const msg = encodeURIComponent(`Hello Sri Tirumala, I would like to order ${itemName} priced at ${price}. Please confirm stock & delivery to Tekkali/AP.`);
        window.open(`https://wa.me/${phone}?text=${msg}`, '_blank');
    };

    // Variant Chip Selection for Spotlight Cards
    window.selectVariant = function (btn, group, price, weight) {
        const parent = btn.parentElement;
        parent.querySelectorAll('.variant-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const priceEl = document.getElementById('price-' + group);
        if (priceEl) priceEl.innerText = price;
    };

    window.toggleRoast = function (btn) {
        const parent = btn.parentElement;
        parent.querySelectorAll('.variant-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    };

    // Provenance Category Ribbon Filtering
    window.filterByProvenance = function (cat, btn) {
        document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const select = document.getElementById('categoryFilter');
        if (select) select.value = cat === 'All' ? 'all' : cat;

        const cards = document.querySelectorAll('.product-item');
        cards.forEach(card => {
            const itemCat = card.dataset.category || '';
            if (cat === 'All' || itemCat.toLowerCase() === cat.toLowerCase()) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });

        // Update catalog counter
        const visible = Array.from(cards).filter(c => c.style.display !== 'none').length;
        const counter = document.getElementById('catalogCounter');
        if (counter) counter.innerText = visible + ' Products Available';

        const noResults = document.getElementById('noResults');
        if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    };

    // Live Search with Instant Debounce
    let searchDebounceTimeout = null;
    window.onSearchInput = function (val) {
        if (searchDebounceTimeout) clearTimeout(searchDebounceTimeout);
        searchDebounceTimeout = setTimeout(() => {
            window.filterProducts();
        }, 220);
    };

    window.searchCatalog = function (term) {
        const searchInput = document.getElementById('searchInput');
        const navInput = document.getElementById('navSearchInput');
        if (searchInput) searchInput.value = term;
        if (navInput) navInput.value = term;
        window.filterProducts();
        const catalogEl = document.getElementById('catalog-section');
        if (catalogEl) catalogEl.scrollIntoView({ behavior: 'smooth' });
    };

    window.syncCategoryFilter = function (catVal) {
        window.filterByProvenance(catVal === 'all' ? 'All' : catVal);
    };

    window.applySort = function (sortVal) {
        const grid = document.getElementById('productGrid');
        if (!grid) return;
        const items = Array.from(grid.querySelectorAll('.product-item'));

        items.sort((a, b) => {
            const priceA = parseFloat(a.dataset.price) || 0;
            const priceB = parseFloat(b.dataset.price) || 0;
            const nameA = a.dataset.name || '';
            const nameB = b.dataset.name || '';

            if (sortVal === 'price_asc') return priceA - priceB;
            if (sortVal === 'price_desc') return priceB - priceA;
            if (sortVal === 'name_asc') return nameA.localeCompare(nameB);
            return 0;
        });

        items.forEach(item => grid.appendChild(item));
    };

    window.filterProducts = function () {
        const searchInput = document.getElementById('searchInput');
        const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        const select = document.getElementById('categoryFilter');
        const category = select ? select.value : 'all';
        const inStockOnly = document.getElementById('inStockOnly') ? document.getElementById('inStockOnly').checked : false;

        const items = document.querySelectorAll('.product-item');
        let visibleCount = 0;

        items.forEach(item => {
            const name = item.dataset.name || '';
            const cat = item.dataset.category || '';
            const stock = parseInt(item.dataset.stock || '0', 10);

            const matchesSearch = !query || name.includes(query) || (item.dataset.barcode && item.dataset.barcode.includes(query));
            const matchesCategory = category === 'all' || cat.toLowerCase() === category.toLowerCase();
            const matchesStock = !inStockOnly || stock > 0;

            if (matchesSearch && matchesCategory && matchesStock) {
                item.style.display = '';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        const counter = document.getElementById('catalogCounter');
        if (counter) counter.innerText = visibleCount + ' Products Available';

        const noResults = document.getElementById('noResults');
        if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    };

    window.clearFilters = function () {
        const searchInput = document.getElementById('searchInput');
        if (searchInput) searchInput.value = '';
        const navInput = document.getElementById('navSearchInput');
        if (navInput) navInput.value = '';
        const select = document.getElementById('categoryFilter');
        if (select) select.value = 'all';
        const inStockOnly = document.getElementById('inStockOnly');
        if (inStockOnly) inStockOnly.checked = false;
        const sortFilter = document.getElementById('sortFilter');
        if (sortFilter) sortFilter.value = 'featured';

        window.filterByProvenance('All');
    };
</script>

