<%- include('header') %>

<% if (locals.activeCategory) { %>
<!-- ==============================================================================
     CATEGORY BREADCRUMB & COLLECTION HERO
     ============================================================================== -->
<section class="category-breadcrumb-section py-4 border-bottom no-print" style="background: linear-gradient(135deg, #FAF8F2 0%, #EDEAE1 100%); border-color: var(--sf-border, #E5ECE7) !important;">
    <div class="max-w-7xl mx-auto px-3">
        <%- include('partials/breadcrumbs', { breadcrumbs: locals.breadcrumbs || [
            { name: 'Home', url: '/' },
            { name: activeCategory, current: true }
        ] }) %>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="font-label-caps text-gold font-bold">Tekkali Storefront Collection</span>
                <h1 class="font-display-hero text-primary font-bold m-0" style="font-size: clamp(26px, 3.2vw, 42px);">
                    Buy Premium <%= activeCategory %> Online
                </h1>
                <p class="font-body-md text-muted mt-2 mb-0" style="max-width: 650px;">
                    Order 100% genuine, hand-sorted <%= activeCategory.toLowerCase() %> direct from Sri Tirumala Dryfruits, Opposite RTC Complex, Tekkali. Fast local and regional dispatch.
                </p>
            </div>
            <div class="badge bg-white text-dark border px-3 py-2 font-label-md shadow-sm align-self-start align-self-md-auto" style="border-radius: 12px;">
                <%= products ? products.length : 0 %> Items in <%= activeCategory %>
            </div>
        </div>
    </div>
</section>
<% } %>

<!-- ==============================================================================
     1. HERO EDITORIAL SECTION (Stitch Artisanal Botanical Luxury)
     ============================================================================== -->
<section class="hero-editorial-section no-print" <% if (locals.activeCategory) { %>style="display: none;"<% } %>>
    <div class="max-w-7xl mx-auto px-3">
        <div class="row align-items-center g-5">
            <!-- Left Editorial Column -->
            <div class="col-12 col-lg-7 z-1">
                <!-- Prestige Pill -->
                <div class="hero-prestige-pill mb-3">
                    <span class="pulsing-gold-dot"></span>
                    <span class="font-label-caps text-primary">1984 Royal Estate Reserve</span>
                    <span class="text-muted">•</span>
                    <span class="font-label-caps text-gold font-bold">Limited Winter Crop</span>
                </div>

                <!-- Headline -->
                <h1 class="font-display-hero text-primary font-bold tracking-tight mb-3">
                    Handpicked Harvest, <br/>
                    <span class="italic font-title-editorial font-normal" style="font-size: clamp(30px, 4.2vw, 54px); color: var(--gold-burnished);">
                        Royal Indulgence.
                    </span>
                </h1>

                <!-- Subtext -->
                <p class="font-body-lg text-muted mb-4" style="max-width: 580px;">
                    Purveyors of heirloom-grade royal dry fruits, grade-A hand-selected jumbo cashews, pure Mongra saffron, and artisanal Medjool dates directly harvested from celebrated family orchards.
                </p>

                <!-- CTA Action Group -->
                <div class="d-flex flex-wrap align-items-center gap-3 pt-1 mb-4">
                    <a href="#festive-spotlight" class="hero-cta-btn-primary">
                        <span>Explore Festive Hampers</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                    <a href="#catalog-section" class="hero-cta-btn-secondary">
                        <span class="material-symbols-outlined text-sm" style="color: var(--gold-burnished);">menu_book</span>
                        <span>Wholesale &amp; Retail Catalog</span>
                    </a>
                </div>

                <!-- Trust Badges Bar -->
                <div class="row g-3 pt-3" style="max-width: 520px;">
                    <div class="col-4">
                        <div class="d-flex align-items-center gap-1" style="color: var(--gold-burnished);">
                            <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                            <strong class="font-price-md text-primary">4.9 / 5</strong>
                        </div>
                        <span class="font-label-caps text-muted" style="font-size: 10px;">12,400+ Patrons</span>
                    </div>
                    <div class="col-4">
                        <div class="d-flex align-items-center gap-1 text-primary">
                            <span class="material-symbols-outlined text-sm text-forest-light">eco</span>
                            <strong class="font-label-lg text-primary">100% Pure</strong>
                        </div>
                        <span class="font-label-caps text-muted" style="font-size: 10px;">Unadulterated</span>
                    </div>
                    <div class="col-4">
                        <div class="d-flex align-items-center gap-1 text-primary">
                            <span class="material-symbols-outlined text-sm" style="color: var(--gold-burnished);">local_shipping</span>
                            <strong class="font-label-lg text-primary">Cold-Chain</strong>
                        </div>
                        <span class="font-label-caps text-muted" style="font-size: 10px;">Same-Day Transit</span>
                    </div>
                </div>
            </div>

            <!-- Right Visual Showcase with Floating Badges -->
            <div class="col-12 col-lg-5 position-relative text-center">
                <!-- Floating Badge 1 (Top Left) -->
                <div class="floating-badge-top animate-pulse d-none d-sm-flex">
                    <div class="w-8 h-8 rounded-circle bg-light d-flex align-items-center justify-content-center text-primary" style="width: 34px; height: 34px;">
                        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1; color: var(--gold-burnished);">military_tech</span>
                    </div>
                    <div class="text-start">
                        <p class="font-label-caps text-muted m-0" style="font-size: 9px;">Heritage Lot</p>
                        <p class="font-label-lg text-primary font-bold m-0" style="font-size: 12px;">Bestseller: Jumbo Mamra</p>
                    </div>
                </div>

                <!-- Central Product Imagery Canvas -->
                <div class="hero-showcase-canvas">
                    <img class="hero-showcase-img" 
                         src="/images/stitch/hero_casket.jpg" 
                         alt="Editorial still life presentation of Sri Tirumala luxury dry fruits casket"
                         loading="eager">
                    <div class="hero-showcase-overlay"></div>
                    <div class="hero-showcase-caption text-start">
                        <span class="font-label-caps text-gold-sheen">Master Harvester Selection</span>
                        <h4 class="font-headline-sm text-white m-0">The Regal Teak Casket</h4>
                        <p class="font-body-sm text-white-50 m-0">Contains 4 Imperial Provenances • 1.2kg Net Weight</p>
                    </div>
                </div>

                <!-- Floating Badge 2 (Bottom Right) -->
                <div class="floating-badge-bottom d-none d-sm-flex">
                    <span class="material-symbols-outlined text-gold-sheen text-base">verified</span>
                    <div class="text-start">
                        <p class="font-label-caps text-white-50 m-0" style="font-size: 9px;">Harvest Dispatch</p>
                        <p class="font-label-lg text-white font-bold m-0" style="font-size: 12px;">Fresh 2026 Winter Lot</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==============================================================================
     2. PROVENANCE CATEGORY FILTER RIBBON (Stitch)
     ============================================================================== -->
<section class="provenance-ribbon-bar no-print">
    <div class="max-w-7xl mx-auto px-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="font-label-caps text-gold font-bold">Select Harvest</span>
                <h2 class="font-headline-sm text-primary m-0">Explore by Provenance</h2>
            </div>
            <div class="d-none d-sm-flex align-items-center gap-1 text-muted font-label-md">
                <span class="material-symbols-outlined text-base">tune</span>
                <span>6 Imperial Categories</span>
            </div>
        </div>

        <!-- Horizontal Pill Scroll -->
        <div class="cat-pill-scroll" id="provenancePills" role="navigation" aria-label="Product Categories">
            <a href="/" 
               class="cat-pill text-decoration-none <%= (!locals.activeCategory || activeCategory === 'All') ? 'active' : '' %>" 
               onclick="if (window.filterByProvenance && window.location.pathname === '/') { event.preventDefault(); filterByProvenance('All', this); }">
                🥥 All Harvests
            </a>
            <% 
            const categoriesToDisplay = (locals.storefrontCategories && storefrontCategories.length > 0)
              ? storefrontCategories
              : [
                { name: 'Dry Fruits', slug: 'Dry%20Fruits', emoji: '🌰', tagline: 'Royal Almonds & Cashews', count: 0 },
                { name: 'Spices', slug: 'Spices', emoji: '🌶️', tagline: 'Kashmiri Walnuts & Saffron', count: 0 },
                { name: 'Nuts', slug: 'Nuts', emoji: '🥜', tagline: 'Imported Dates & Figs', count: 0 },
                { name: 'Millets', slug: 'Millets', emoji: '🌾', tagline: 'Wholesome Millets', count: 0 },
                { name: 'Seeds', slug: 'Seeds', emoji: '🌱', tagline: 'Superfood Berries & Seeds', count: 0 },
                { name: 'Sweets', slug: 'Sweets', emoji: '🍬', tagline: 'Handcrafted Gift Boxes', count: 0 }
              ];
            categoriesToDisplay.forEach(function(cat) { 
                const isActive = (locals.activeCategory && activeCategory.toLowerCase() === cat.name.toLowerCase());
            %>
            <a href="/category/<%= cat.slug %>" 
               class="cat-pill text-decoration-none <%= isActive ? 'active' : '' %>"
               title="Explore <%= cat.name %> - <%= cat.tagline %>"
               onclick="if (window.filterByProvenance && window.location.pathname === '/') { event.preventDefault(); filterByProvenance('<%= cat.name.replace(/'/g, "\\'") %>', this); }">
                <%= cat.emoji %> <%= cat.tagline %>
            </a>
            <% }); %>
        </div>
    </div>
</section>

