<!-- ==============================================================================
     4. LIVE CATALOG SECTION (Real SQLite Database Products)
     ============================================================================== -->
<section class="py-5 no-print" id="catalog-section" style="background: var(--surface-container-low);">
    <div class="max-w-7xl mx-auto px-3">
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
            <div>
                <span class="font-label-caps text-gold font-bold">Tekkali Store Catalog</span>
                <h2 class="font-headline-lg text-primary m-0">Live Harvest Offerings</h2>
            </div>
            <div class="badge bg-white text-dark border px-3 py-2 font-label-md" id="catalogCounter">
                <%= products ? products.length : 0 %> Products Available
            </div>
        </div>

        <!-- Search & Filter Controls -->
        <div class="search-toolbar-card mb-4">
            <div class="row g-3 align-items-center">
                <!-- Live Search -->
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">🔍</span>
                        <input type="search" 
                               id="searchInput" 
                               class="form-control bg-light border-start-0 py-2" 
                               placeholder="Search harvest, nuts, seeds, millets... (Press '/' to focus)" 
                               aria-label="Search catalog"
                               oninput="onSearchInput(this.value)">
                    </div>
                </div>

                <!-- Category Filter -->
                <div class="col-6 col-md-3">
                    <select id="categoryFilter" class="form-select py-2" aria-label="Select category" onchange="syncCategoryFilter(this.value)">
                        <option value="all">All Harvest Categories</option>
                        <% if (locals.storefrontCategories && storefrontCategories.length > 0) { %>
                            <% storefrontCategories.forEach(function(cat) { %>
                                <option value="<%= cat.name %>" <%= (locals.activeCategory && activeCategory.toLowerCase() === cat.name.toLowerCase()) ? 'selected' : '' %>>
                                    <%= cat.shortName %>
                                </option>
                            <% }); %>
                        <% } else { %>
                            <option value="Dry Fruits">Dry Fruits &amp; Almonds</option>
                            <option value="Millets">Wholesome Millets</option>
                            <option value="Seeds">Exotic Seeds &amp; Berries</option>
                            <option value="Spices">Kashmiri Saffron &amp; Spices</option>
                            <option value="Nuts">Crunchy Nuts &amp; Dates</option>
                            <option value="Sweets">Handcrafted Hampers</option>
                        <% } %>
                    </select>
                </div>

                <!-- Sort Filter -->
                <div class="col-6 col-md-2">
                    <select id="sortFilter" class="form-select py-2" aria-label="Sort products by" onchange="applySort(this.value)">
                        <option value="featured">Featured Lots</option>
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                        <option value="name_asc">Name: A to Z</option>
                    </select>
                </div>

                <!-- In-Stock Switch & Reset -->
                <div class="col-12 col-md-2 d-flex align-items-center justify-content-between gap-2">
                    <div class="form-check form-switch m-0 d-flex align-items-center gap-1" title="Show only in-stock products">
                        <input class="form-check-input" type="checkbox" role="switch" id="inStockOnly" onchange="filterProducts()">
                        <label class="form-check-label small fw-semibold text-muted" for="inStockOnly" style="font-size: 0.78rem;">In-Stock</label>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm py-2 px-3 fw-bold" style="border-radius: 8px;" title="Reset filters" onclick="clearFilters()">
                        ✕ Clear
                    </button>
                </div>
            </div>
        </div>

        <!-- Dynamic Product Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4" id="productGrid">
            <% if (products && products.length > 0) { %>
                <% products.forEach(function(p) { 
                    let emoji = "🥥"; 
                    const cat = p.category || 'Dry Fruits'; 
                    if (cat === 'Dry Fruits') emoji = "🌰"; 
                    else if (cat === 'Millets') emoji = "🌾"; 
                    else if (cat === 'Seeds') emoji = "🌱"; 
                    else if (cat === 'Spices') emoji = "🌶️"; 
                    else if (cat === 'Nuts') emoji = "🥜"; 
                    else if (cat === 'Sweets') emoji = "🍬"; 
                    const stock = (p.total_qty || 0) - (p.sold_qty || 0); 
                    const hasDiscount = p.mrp && Number(p.mrp) > Number(p.selling_price);
                    const discountPercent = hasDiscount ? Math.round(((Number(p.mrp) - Number(p.selling_price)) / Number(p.mrp)) * 100) : 0;
                %>
                <div class="col product-item" 
                     data-id="<%= p.id %>" 
                     data-name="<%= p.name.toLowerCase() %>"
                     data-barcode="<%= p.barcode %>" 
                     data-category="<%= cat %>" 
                     data-price="<%= p.selling_price %>"
                     data-stock="<%= stock %>">

                    <div class="product-card-luxury">
                        <!-- Card Top Badges -->
                        <div class="card-badge-row">
                            <% if (hasDiscount) { %>
                                <span class="badge-discount-tag"><%= discountPercent %>% Off</span>
                            <% } else { %>
                                <span class="badge-discount-tag" style="background: var(--cream-container); color: var(--primary);">Grade AAA</span>
                            <% } %>

                            <button type="button" 
                                    class="wishlist-toggle-btn border-0 bg-transparent p-0" 
                                    data-id="<%= p.id %>"
                                    data-name="<%= p.name %>" 
                                    data-price="<%= p.selling_price %>"
                                    data-mrp="<%= p.mrp || '' %>" 
                                    data-image="<%= p.image_url || '' %>"
                                    data-category="<%= cat %>" 
                                    data-stock="<%= stock %>"
                                    aria-label="Add to wishlist" 
                                    title="Add to Wishlist">
                                <span>🤍</span>
                            </button>
                        </div>

                        <!-- Product Media -->
                        <div class="product-media-canvas">
                            <a href="/product/<%= p.id %>" class="d-block w-100 h-100 text-decoration-none">
                                <% if (p.image_url) { %>
                                    <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="w-100 h-100 d-none align-items-center justify-content-center fs-1"><%= emoji %></div>
                                <% } else { %>
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center fs-1"><%= emoji %></div>
                                <% } %>
                            </a>
                            <span class="provenance-tag-overlay"><%= cat %></span>
                        </div>

                        <!-- Product Meta -->
                        <span class="provenance-label"><%= cat %> • Heirloom Lot</span>
                        <a href="/product/<%= p.id %>" class="product-title-editorial" title="<%= p.name %>">
                            <%= p.name %>
                        </a>

                        <!-- Stock Status -->
                        <div class="mb-2">
                            <% if (stock <= 0) { %>
                                <span class="badge bg-secondary" style="font-size: 10px;">Out of Stock</span>
                            <% } else if (stock < 10) { %>
                                <span class="badge bg-warning text-dark" style="font-size: 10px;">Only <%= stock %> left</span>
                            <% } else { %>
                                <span class="badge bg-success" style="font-size: 10px;">In Stock • Nitrogen Sealed</span>
                            <% } %>
                        </div>

                        <!-- Price Container -->
                        <div class="price-stock-box">
                            <div class="d-flex align-items-baseline">
                                <span class="price-main">₹<%= Number(p.selling_price).toFixed(2) %></span>
                                <% if (hasDiscount) { %>
                                    <span class="price-mrp">₹<%= Number(p.mrp).toFixed(2) %></span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" 
                                    class="btn-quick-add flex-grow-1 add-to-cart-btn"
                                    data-id="<%= p.id %>" 
                                    data-name="<%= p.name %>" 
                                    data-price="<%= p.selling_price %>"
                                    data-stock="<%= stock %>" 
                                    onclick="window.Storefront && window.Storefront.addToCart(<%= p.id %>, 1, '<%= p.name.replace(/'/g, "\\'") %>')"
                                    <%= stock <= 0 ? 'disabled' : '' %>>
                                <span><%= stock <= 0 ? 'Out of Stock' : 'Quick Add +' %></span>
                            </button>

                            <button type="button" 
                                    class="btn-whatsapp-icon whatsapp-card-btn"
                                    data-id="<%= p.id %>" 
                                    data-name="<%= p.name %>" 
                                    data-price="<%= p.selling_price %>"
                                    data-category="<%= cat %>"
                                    onclick="window.Storefront && window.Storefront.orderProductViaWhatsApp(this.dataset)"
                                    title="Order on WhatsApp">
                                <span>💬</span>
                            </button>
                        </div>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center text-muted py-5">
                    <% if (locals.activeCategory && activeCategory !== 'All') { %>
                        <span class="fs-1 d-block mb-2">🌾</span>
                        <h5 class="font-headline-sm text-primary"><%= activeCategory %> Collection Arriving Soon</h5>
                        <p class="font-body-sm max-w-600 mx-auto mb-3">Our artisans and farmers are preparing upcoming fresh harvest batches for the <%= activeCategory %> collection. In the meantime, explore our flagship Dry Fruits and Seeds selections.</p>
                        <a href="/category/Dry%20Fruits" class="btn btn-brand px-4 py-2 text-decoration-none fw-bold" style="border-radius: 50px;">
                            Browse Royal Dry Fruits
                        </a>
                    <% } else { %>
                        <span class="fs-1 d-block mb-2">🛍️</span>
                        <h5 class="font-headline-sm text-primary">No products currently available</h5>
                        <p class="font-body-sm">Please check back soon for our newest harvest selections.</p>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- No Results Fallback -->
        <div id="noResults" class="text-center text-muted py-5 my-4" style="display:none;">
            <span class="fs-1 d-block mb-2">🔍</span>
            <h5 class="font-headline-sm text-primary">No matching harvest items found</h5>
            <p class="font-body-sm max-w-600 mx-auto mb-3">Try adjusting your search keyword or clearing the active filters.</p>
            <button class="btn btn-brand px-4 py-2" onclick="clearFilters()" style="border-radius: 50px;">
                Reset All Filters
            </button>
        </div>
    </div>
</section>

