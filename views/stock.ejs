<%- include('header') %>

<% 
let lowStockItems = [];
let outOfStockCount = 0;
let totalUniqueItems = products ? products.length : 0;

if (products && products.length > 0) {
    products.forEach(function(p) {
        const remaining = p.total_qty - (p.sold_qty || 0);
        if (remaining <= 0) {
            outOfStockCount++;
        }
        if (remaining < 5) {
            lowStockItems.push(p);
        }
    });
}
%>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill mb-2 fw-bold" style="font-size: 0.8rem;">INVENTORY CONTROL</span>
        <h2 style="color: var(--brand-green);" class="brand-font m-0">📦 Stock Inventory</h2>
    </div>
    
    <% if (session && session.role === 'admin') { %>
        <a href="/add" class="btn btn-success fw-bold d-flex align-items-center gap-2" style="border-radius: 12px; padding: 12px 24px;">
            <span>➕</span> Add New Product
        </a>
    <% } %>
</div>

<!-- INVENTORY METRICS CARDS -->
<div class="row g-3 mb-4 no-print">
    <div class="col-md-4">
        <div class="card p-3 border-0 bg-white shadow-sm h-100" style="border-left: 4px solid var(--brand-green) !important; border-top: none;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Total Catalog Items</small>
                    <h3 class="fw-extrabold text-dark m-0 mt-1" style="font-family: 'Plus Jakarta Sans', sans-serif;"><%= totalUniqueItems %> Unique</h3>
                </div>
                <span class="fs-2 text-success opacity-50">📋</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-0 bg-white shadow-sm h-100" style="border-left: 4px solid #dc3545 !important; border-top: none;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Low Stock Warnings</small>
                    <h3 class="fw-extrabold text-danger m-0 mt-1" style="font-family: 'Plus Jakarta Sans', sans-serif;"><%= lowStockItems.length %> Alerts</h3>
                </div>
                <span class="fs-2 text-danger opacity-50">⚠️</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-0 bg-white shadow-sm h-100" style="border-left: 4px solid var(--brand-gold) !important; border-top: none;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Out of Stock Items</small>
                    <h3 class="fw-extrabold text-warning m-0 mt-1" style="font-family: 'Plus Jakarta Sans', sans-serif; color: #b18b10 !important;"><%= outOfStockCount %> Products</h3>
                </div>
                <span class="fs-2 text-warning opacity-50">🚫</span>
            </div>
        </div>
    </div>
</div>

<% if (lowStockItems.length > 0) { %>
<div class="alert alert-danger shadow-sm border-start border-4 border-danger mb-4 no-print p-3" role="alert" style="border-radius: 12px; background-color: #fff8f8;">
    <div class="d-flex align-items-center gap-2 mb-2">
        <h5 class="alert-heading fw-bold m-0" style="font-size: 1.05rem;">⚠️ High Priority Restock Required</h5>
    </div>
    <p class="m-0 text-muted small">The following premium items are running critical (under 5.000 units remaining). Please restock soon:</p>
    <div class="mt-2 d-flex flex-wrap gap-2">
        <% lowStockItems.forEach(function(item) { %>
            <% const rem = item.total_qty - (item.sold_qty || 0); %>
            <span class="badge bg-danger bg-opacity-10 text-danger p-2 border border-danger border-opacity-25" style="font-size: 0.8rem; font-weight: 600;">
                <%= item.name %> &rarr; <strong><%= Number(rem).toFixed(3) %> left</strong>
            </span>
        <% }); %>
    </div>
</div>
<% } %>

<!-- FILTERS SECTION -->
<div class="card p-4 mb-4 shadow-sm border-0" style="border-radius: 16px;">
    <div class="row g-3 align-items-center">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 border-success" style="padding-left: 16px;">🔍</span>
                <input type="text" id="searchInput" class="form-control border-start-0 border-success" placeholder="Search product name or scan barcode to filter inventory..." onkeyup="filterStock()">
            </div>
        </div>
        
        <div class="col-md-5">
            <div class="d-flex justify-content-md-end">
                <button class="btn btn-sm btn-outline-success px-3 me-2 fw-bold" onclick="clearSearchAndCategory()">Clear Filters</button>
            </div>
        </div>
    </div>

    <div class="mt-3 pt-3 border-top border-light d-flex flex-wrap gap-1 align-items-center">
        <span class="text-muted small fw-bold me-2">QUICK CATEGORY:</span>
        <button class="btn btn-sm btn-success px-3 active-filter rounded-pill" onclick="filterCategory('All', this)">All</button>
        <button class="btn btn-sm btn-outline-success px-3 rounded-pill" onclick="filterCategory('Dry Fruits', this)">Dry Fruits</button>
        <button class="btn btn-sm btn-outline-success px-3 rounded-pill" onclick="filterCategory('Millets', this)">Millets</button>
        <button class="btn btn-sm btn-outline-success px-3 rounded-pill" onclick="filterCategory('Seeds', this)">Seeds</button>
        <button class="btn btn-sm btn-outline-success px-3 rounded-pill" onclick="filterCategory('Spices', this)">Spices</button>
        <button class="btn btn-sm btn-outline-success px-3 rounded-pill" onclick="filterCategory('Nuts', this)">Nuts</button>
        <button class="btn btn-sm btn-outline-success px-3 rounded-pill" onclick="filterCategory('Sweets', this)">Sweets</button>
    </div>
</div>

<!-- INVENTORY TABLE CONTAINER -->
<div class="card shadow-sm border-0 overflow-hidden" style="border-radius: 20px;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="stockTable">
            <thead class="text-white" style="background-color: var(--brand-green);">
                <tr>
                    <th class="py-3 ps-4" style="font-size: 0.8rem; letter-spacing: 0.05em;">Product Details</th>
                    <th class="py-3" style="font-size: 0.8rem; letter-spacing: 0.05em; width: 140px;">Barcode</th>
                    <th class="py-3 text-center" style="font-size: 0.8rem; letter-spacing: 0.05em; width: 180px;">Remaining Stock</th>
                    <th class="py-3" style="font-size: 0.8rem; letter-spacing: 0.05em; width: 110px;">MRP</th>
                    <th class="py-3" style="font-size: 0.8rem; letter-spacing: 0.05em; width: 120px;">Sell Price</th>
                    <th class="py-3 text-center" style="font-size: 0.8rem; letter-spacing: 0.05em; width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(p) { %>
                    <% const remaining = p.total_qty - (p.sold_qty || 0); %>
                    <tr class="stock-row" data-category="<%= p.category || 'Dry Fruits' %>">
                        <td class="ps-4 py-3 product-name">
                            <div class="d-flex align-items-center gap-3">
                                <div class="product-thumbnail-wrapper" style="width: 44px; height: 44px; position: relative; flex-shrink: 0; background: #f8f9fa; border-radius: 8px; border: 1px solid #e9ecef; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    <% 
                                    let catEmoji = '🥥';
                                    const categoryUpper = (p.category || '').toUpperCase();
                                    if (categoryUpper.includes('MILLET')) catEmoji = '🌾';
                                    else if (categoryUpper.includes('SEED')) catEmoji = '🌻';
                                    else if (categoryUpper.includes('SPICE')) catEmoji = '🌶️';
                                    else if (categoryUpper.includes('NUT')) catEmoji = '🥜';
                                    else if (categoryUpper.includes('SWEET')) catEmoji = '🍬';
                                    %>
                                    <% if (p.image_url) { %>
                                        <img src="<%= p.image_url %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                        <span class="fs-4 text-muted" style="display: none;"><%= catEmoji %></span>
                                    <% } else { %>
                                        <span class="fs-4"><%= catEmoji %></span>
                                    <% } %>
                                </div>
                                <div>
                                    <span class="fw-bold text-dark d-block fs-6"><%= p.name %></span>
                                    <span class="badge bg-secondary text-uppercase font-monospace mt-1 bg-opacity-10 text-secondary border border-secondary border-opacity-10" style="font-size: 0.65rem; letter-spacing: 0.03em;"><%= p.category || 'Dry Fruits' %></span>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted small font-monospace product-code" style="font-size: 0.82rem;"><%= p.barcode %></td>
                        
                        <td class="text-center py-3">
                            <% if (remaining <= 0) { %>
                                <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.78rem;">OUT OF STOCK (0.00)</span>
                            <% } else if (remaining < 5) { %>
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-bold border border-danger border-opacity-10" style="font-size: 0.78rem;"><%= Number(remaining).toFixed(3) %> (Low)</span>
                            <% } else { %>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold border border-success border-opacity-10" style="font-size: 0.78rem;"><%= Number(remaining).toFixed(3) %></span>
                            <% } %>
                        </td>

                        <td class="text-muted text-decoration-line-through text-nowrap" style="font-size: 0.92rem;">₹<%= Number(p.mrp || 0).toFixed(2) %></td>
                        <td class="fw-bold text-success text-nowrap" style="font-size: 1.05rem;">₹<%= Number(p.selling_price || 0).toFixed(2) %></td>
                        
                        <td class="text-center py-3">
                            <div class="d-flex justify-content-center gap-1">
                                <a href="/print_label/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-dark" title="Print Sticker Label" style="border-radius: 8px; padding: 6px 10px;">
                                    🖨️
                                </a>
                                <a href="/add_stock/<%= p.id %>" class="btn btn-sm btn-success text-white" title="Quick Restock" style="border-radius: 8px; padding: 6px 12px; font-size: 0.8rem;">
                                    ➕ Restock
                                </a>

                                <% if (session && session.role === 'admin') { %>
                                    <a href="/edit/<%= p.id %>" class="btn btn-sm btn-outline-primary" title="Edit details" style="border-radius: 8px; padding: 6px 10px;">
                                        ✏️
                                    </a>
                                    <form action="/delete/<%= p.id %>" method="POST" style="display:inline;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this item completely from registry?')" title="Delete product" style="border-radius: 8px; padding: 6px 10px;">🗑️</button>
                                    </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No products available in database. Add one above to get started!</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    let currentCategory = 'All';
    let currentFilterText = '';

    function filterCategory(cat, btn) {
        currentCategory = cat;
        const btns = btn.parentNode.querySelectorAll('button');
        btns.forEach(b => {
            b.classList.remove('btn-success', 'active-filter');
            b.classList.add('btn-outline-success');
        });
        btn.classList.remove('btn-outline-success');
        btn.classList.add('btn-success', 'active-filter');
        applyFilters();
    }

    function filterStock() {
        currentFilterText = document.getElementById("searchInput").value.toUpperCase();
        applyFilters();
    }

    function clearSearchAndCategory() {
        document.getElementById("searchInput").value = '';
        currentFilterText = '';
        const btns = document.querySelectorAll('.rounded-pill');
        if(btns.length > 0) {
            filterCategory('All', btns[0]);
        } else {
            applyFilters();
        }
    }

    function applyFilters() {
        var rows = document.getElementsByClassName("stock-row");

        for (var i = 0; i < rows.length; i++) {
            var name = rows[i].getElementsByClassName("product-name")[0].innerText;
            var code = rows[i].getElementsByClassName("product-code")[0].innerText;
            var cat = rows[i].getAttribute("data-category") || 'Dry Fruits';
            
            var matchesSearch = name.toUpperCase().indexOf(currentFilterText) > -1 || code.indexOf(currentFilterText) > -1;
            var matchesCategory = currentCategory === 'All' || cat === currentCategory;

            if (matchesSearch && matchesCategory) {
                rows[i].style.display = "";
            } else {
                rows[i].style.display = "none";
            }
        }
    }
</script>

<%- include('footer') %>
