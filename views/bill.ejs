<%- include('header') %>

<style>
    /* ==============================================================================
       THERMAL RECEIPT SLATE WRAPPER & PRINT STYLES (Stitch)
       ============================================================================== */
    .thermal-receipt-slate-wrap {
        background-color: #F4F5F7;
        min-height: 100vh;
        padding: 24px 16px 60px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    .thermal-slip-paper {
        width: 330px;
        max-width: 100%;
        background: #FFFFFF;
        color: #000000;
        padding: 24px 20px 28px 20px;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 11.5px;
        line-height: 1.35;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
        border-radius: 4px;
        position: relative;
        border-top: 5px solid #052E16;
    }

    /* Elegant thermal zig-zag paper tear border */
    .thermal-slip-paper::after {
        content: "";
        position: absolute;
        bottom: -8px; left: 0; right: 0;
        height: 8px;
        background-image: linear-gradient(-45deg, transparent 4px, #FFFFFF 4px), 
                          linear-gradient(45deg, transparent 4px, #FFFFFF 4px);
        background-size: 8px 12px;
    }

    .thermal-header { text-align: center; margin-bottom: 12px; }
    .store-brand-title { 
        font-size: 18px; 
        font-weight: 800; 
        text-transform: uppercase; 
        margin-bottom: 2px; 
        color: #052E16;
        letter-spacing: 0.04em;
    }
    .store-sub-detail { font-size: 10.5px; color: #333333; margin-bottom: 2px; font-weight: 500; }

    .thermal-title-bar { 
        text-align: center; 
        font-weight: 800; 
        margin: 8px 0; 
        border-top: 1px dashed #000000;
        border-bottom: 1px dashed #000000; 
        padding: 6px 0; 
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.08em;
    }

    .thermal-meta-row {
        display: flex; 
        justify-content: space-between; 
        font-weight: 700; 
        font-size: 11.5px; 
        margin-bottom: 4px;
    }

    .thermal-row-item-name { 
        font-weight: 700; 
        font-size: 11.5px; 
        margin-top: 4px;
    }
    .thermal-row-item-cols { 
        font-size: 10.5px; 
        display: flex; 
        justify-content: space-between; 
        margin-bottom: 4px; 
    }

    .thermal-summary-box { 
        border-top: 1px dashed #000000; 
        margin-top: 8px; 
        padding-top: 6px; 
    }
    .thermal-flex-row { 
        display: flex; 
        justify-content: space-between; 
        margin-bottom: 3px;
    }

    .thermal-net-total-row { 
        font-size: 19px; 
        font-weight: 800; 
        border-top: 1.5px dashed #000000; 
        border-bottom: 1.5px dashed #000000;
        padding: 8px 0; 
        margin: 8px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .thermal-tax-table {
        border: 1px dashed #000000;
        margin-top: 8px;
        padding: 6px;
        font-size: 9.5px;
    }

    .thermal-footer-notes { 
        text-align: center; 
        font-size: 10.5px; 
        margin-top: 14px; 
        border-top: 1px dashed #000000; 
        padding-top: 10px; 
        line-height: 1.4;
    }

    @media print {
        @page { margin: 0; size: auto; }
        body { margin: 0; padding: 0; background: #FFFFFF !important; }
        .no-print { display: none !important; }
        .thermal-receipt-slate-wrap { background: none !important; padding: 0 !important; }
        .thermal-slip-paper { width: 100% !important; padding: 10px !important; box-shadow: none !important; border-top: none !important; }
        .thermal-slip-paper::after { display: none !important; }
        * { color: #000000 !important; background: transparent !important; }
    }
</style>

<script>
function numToWords(n) {
    const a = ['','One ','Two ','Three ','Four ', 'Five ','Six ','Seven ','Eight ','Nine ','Ten ','Eleven ','Twelve ','Thirteen ','Fourteen ','Fifteen ','Sixteen ','Seventeen ','Eighteen ','Nineteen '];
    const b = ['', '', 'Twenty','Thirty','Forty','Fifty', 'Sixty','Seventy','Eighty','Ninety'];
    if ((n = n.toString()).length > 9) return 'overflow';
    const match = ('000000000' + n).slice(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
    if (!match) return ''; 
    let str = '';
    str += (match[1] !== '00') ? (a[Number(match[1])] || b[match[1][0]] + ' ' + a[match[1][1]]) + 'Crore ' : '';
    str += (match[2] !== '00') ? (a[Number(match[2])] || b[match[2][0]] + ' ' + a[match[2][1]]) + 'Lakh ' : '';
    str += (match[3] !== '00') ? (a[Number(match[3])] || b[match[3][0]] + ' ' + a[match[3][1]]) + 'Thousand ' : '';
    str += (match[4] !== '0') ? (a[Number(match[4])] || b[match[4][0]] + ' ' + a[match[4][1]]) + 'Hundred ' : '';
    str += (match[5] !== '00') ? ((str !== '') ? 'and ' : '') + (a[Number(match[5])] || b[match[5][0]] + ' ' + a[match[5][1]]) + 'Only' : '';
    return str.trim();
}
</script>

<div class="thermal-receipt-slate-wrap">
    
    <!-- Top Action Notice (Non-Printable) -->
    <div class="text-center no-print mb-4" style="max-width: 480px;">
        <span class="badge bg-success bg-opacity-10 text-success py-2 px-3 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined" style="font-size: 1.1rem;">check_circle</span> Invoice #<%= sale_id %> Successfully Finalized
        </span>
        <h4 class="fw-bold text-dark m-0" style="color: #052E16 !important;">Thermal Cash Memorandum Issued</h4>
        <p class="text-muted small mt-1 mb-0">
            Print thermal slip directly or press <kbd class="bg-light text-dark border">Esc</kbd> for the next customer counter transaction.
        </p>
    </div>

    <!-- Authentic Thermal Slip Paper Container -->
    <div class="thermal-slip-paper" id="printableReceipt">
        
        <!-- Store Identity Header -->
        <div class="thermal-header">
            <div class="store-brand-title">SRI TIRUMALA</div>
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 3px; color: #222; letter-spacing: 0.06em;">
                Dry Fruits &amp; Millets
            </div>
            <div class="store-sub-detail">OPP RTC COMPLEX, TEKKALI, AP - 532201</div>
            <div class="store-sub-detail">PHONE: +91 9133133931</div>
            <div class="store-sub-detail" style="font-size: 9.5px;">GSTIN: 37AAAAA0000A1Z5 • FSSAI: 20124000000000</div>
        </div>

        <!-- Title -->
        <div class="thermal-title-bar">CASH MEMORANDUM / RETAIL INVOICE</div>

        <!-- Invoice Meta Details -->
        <div class="thermal-meta-row">
            <span>Bill No: <strong style="font-size: 13.5px;"><%= sale_id %></strong></span>
            <span>Date: <%= date %></span>
        </div>

        <div class="thermal-meta-row" style="margin-top: 0;">
            <span>Payment: <strong><%= typeof payment_method !== 'undefined' && payment_method ? payment_method : 'Cash' %></strong></span>
            <span>Time: <%= time %></span>
        </div>

        <% if ((typeof customer_name !== 'undefined' && customer_name) || (typeof customer_phone !== 'undefined' && customer_phone)) { %>
        <div style="border-bottom: 1px dashed #000000; padding-bottom: 5px; margin-bottom: 6px; font-size: 11px;">
            <% if (customer_name) { %><div><strong>Customer:</strong> <%= customer_name %></div><% } %>
            <% if (customer_phone) { %><div><strong>Phone:</strong> <%= customer_phone %></div><% } %>
        </div>
        <% } %>

        <!-- Item Columns Header -->
        <div style="border-bottom: 1px dashed #000000; margin-bottom: 6px; padding-bottom: 4px;">
            <div style="display:flex; font-size:11px; font-weight:bold;">
                <span style="width:12%">SNo</span>
                <span style="width:88%">Item Description</span>
            </div>
            <div style="display:flex; font-size:10.5px; justify-content: space-between; margin-top:2px; font-weight: bold;">
                <span style="width:20%">MRP</span>
                <span style="width:20%">Disc</span>
                <span style="width:20%">Rate</span>
                <span style="width:15%; text-align:center;">Qty</span>
                <span style="width:25%; text-align:right;">Amount</span>
            </div>
        </div>

        <!-- Line Items Loop -->
        <% 
        let gross = 0;
        let total_disc = 0;
        let total_qty = 0;
        let taxSummary = {};

        if (items && items.length > 0) {
            items.forEach(function(item, index) { 
                const item_mrp = item.mrp ? item.mrp : item.price;
                const item_disc = item_mrp - item.price;
                const line_gross = item_mrp * item.qty;
                const item_total = item.price * item.qty;

                const tRate = item.tax_rate || 5;
                const baseP = item_total / (1 + (tRate / 100));
                const taxAmt = item_total - baseP;
                if (!taxSummary[tRate]) taxSummary[tRate] = { base: 0, tax: 0 };
                taxSummary[tRate].base += baseP;
                taxSummary[tRate].tax += taxAmt;

                gross += line_gross;
                total_disc += item_disc * item.qty;
                total_qty += Number(item.qty);
        %>
            <div style="border-bottom: 1px dotted #cccccc; padding-bottom: 3px; margin-bottom: 3px;">
                <div class="thermal-row-item-name">
                    <span style="margin-right: 4px;"><%= index + 1 %></span> <%= item.name %>
                </div>
                <div class="thermal-row-item-cols">
                    <span style="width:20%"><%= Number(item_mrp).toFixed(2) %></span>
                    <span style="width:20%"><%= Number(item_disc).toFixed(2) %></span>
                    <span style="width:20%"><%= Number(item.price).toFixed(2) %></span>
                    <span style="width:15%; text-align:center;"><%= Number(item.qty).toFixed(3) %></span>
                    <span style="width:25%; text-align:right; font-weight:bold;"><%= Number(item.total).toFixed(2) %></span>
                </div>
            </div>
        <% 
            });
        } 
        %>

        <!-- Summary Totals -->
        <div class="thermal-summary-box">
            <div class="thermal-flex-row">
                <span>Gross Total :</span>
                <span>₹<%= Number(gross).toFixed(2) %></span>
            </div>
            <div class="thermal-flex-row">
                <span>Item Discount :</span>
                <span>-₹<%= Number(total_disc).toFixed(2) %></span>
            </div>
            <% if (typeof discount_amount !== 'undefined' && discount_amount > 0) { %>
            <div class="thermal-flex-row" style="font-weight: bold;">
                <span>Bill Discount :</span>
                <span>-₹<%= Number(discount_amount).toFixed(2) %></span>
            </div>
            <% } %>
            <div class="thermal-flex-row" style="font-weight: bold; border-top: 1px dotted #000000; padding-top: 4px; margin-top: 4px;">
                <span>Total Savings :</span>
                <span>₹<%= Number(total_disc + (typeof discount_amount !== 'undefined' ? discount_amount : 0)).toFixed(2) %></span>
            </div>
        </div>

        <!-- Net Total Payable (Prominent) -->
        <div class="thermal-net-total-row">
            <span>Net Payable :</span>
            <span>₹<%= Number(total).toFixed(2) %></span>
        </div>

        <!-- GST Tax Summary Table -->
        <% if (Object.keys(taxSummary).length > 0) { %>
        <div class="thermal-tax-table">
            <div style="text-align: center; font-weight: bold; margin-bottom: 3px; text-transform: uppercase;">
                Tax Summary (Included in Net)
            </div>
            <div style="display: flex; font-weight: bold; border-bottom: 1px dotted #000; padding-bottom: 2px; margin-bottom: 3px;">
                <span style="width: 25%">Rate</span>
                <span style="width: 25%; text-align: center;">Base</span>
                <span style="width: 25%; text-align: center;">CGST</span>
                <span style="width: 25%; text-align: right;">SGST</span>
            </div>
            <% Object.keys(taxSummary).forEach(function(rate) { 
                if (Number(rate) > 0) {
                    const base = taxSummary[rate].base;
                    const halfTax = taxSummary[rate].tax / 2;
            %>
            <div style="display: flex; margin-bottom: 2px;">
                <span style="width: 25%"><%= rate %>%</span>
                <span style="width: 25%; text-align: center;"><%= Number(base).toFixed(2) %></span>
                <span style="width: 25%; text-align: center;"><%= Number(halfTax).toFixed(2) %></span>
                <span style="width: 25%; text-align: right;"><%= Number(halfTax).toFixed(2) %></span>
            </div>
            <%  } 
            }); %>
        </div>
        <% } %>

        <!-- Currency in Words -->
        <div style="font-size: 10.5px; margin-top: 6px; font-weight: bold; text-align: left; line-height: 1.35;">
            RUPEES IN WORDS: <span id="word-display" style="text-transform: uppercase; font-weight: 500; font-size: 10px;"></span>
        </div>

        <!-- Meta Counters -->
        <div class="thermal-flex-row" style="margin-top: 10px; font-size: 10.5px;">
            <span>Items Count: <%= items ? items.length : 0 %></span>
            <span>Total Qty: <%= Number(total_qty).toFixed(3) %></span>
        </div>
        <div class="thermal-flex-row" style="font-size: 10.5px; margin-top: 2px;">
            <span>Billed By: <%= session && session.user ? session.user : 'Staff' %></span>
            <span><%= time %></span>
        </div>

        <!-- Footer Notes -->
        <div class="thermal-footer-notes">
            <div style="font-weight: bold; margin-bottom: 2px;">* FREE LOCAL HOME DELIVERY *</div>
            <div style="margin-bottom: 4px;">* NO EXCHANGE &amp; NO RETURN *</div>
            <div style="font-weight: bold; letter-spacing: 0.05em; font-size: 11px; margin-top: 4px;">*** THANK YOU &amp; VISIT AGAIN ***</div>
        </div>
    </div>

    <!-- Non-Printable Action Buttons -->
    <div class="text-center mt-4 no-print" style="width: 330px; max-width: 100%;">
        <div class="d-grid gap-2">
            <button onclick="printAndNext()" 
                    class="btn btn-success btn-lg py-3 fw-bold shadow d-flex align-items-center justify-content-center gap-2" 
                    style="border-radius: 10px; font-size: 1.05rem; background: #052E16; border-color: #052E16; color: #FAF8F5;">
                <span class="material-symbols-outlined" style="font-size: 1.25rem;">print</span>
                <span>PRINT SLIP</span>
                <span class="shortcut-badge text-white bg-white bg-opacity-25">F1 / Enter</span>
            </button>
            <a href="/bill/pdf/<%= sale_id %>" target="_blank" class="btn btn-outline-dark py-2 fw-bold d-inline-flex align-items-center justify-content-center gap-1" style="border-radius: 8px;">
                <span class="material-symbols-outlined" style="font-size: 1.15rem;">picture_as_pdf</span> Download PDF Receipt
            </a>
            <a href="/sell" class="btn btn-outline-secondary py-2 fw-semibold" style="border-radius: 8px;">
                &larr; Next Customer (Esc)
            </a>
        </div>
    </div>

    <!-- Return Policy Processing Section -->
    <% if (typeof allow_return !== 'undefined' && allow_return && items && items.length > 0) { %>
    <div class="mt-5 no-print" style="width: 480px; max-width: 100%;">
        <div class="card p-3 border-danger shadow-sm bg-white" style="border-radius: 14px; border: 1.5px solid rgba(220, 53, 69, 0.25) !important;">
            <div class="text-center mb-2">
                <span class="fs-4">↩️</span>
                <h6 class="text-danger fw-bold m-0 mt-1">Return Policy Processing</h6>
                <small class="text-muted">Process line items below to return stock to physical shelf inventory.</small>
            </div>
            
            <div class="table-responsive bg-white rounded border border-light">
                <table class="table table-hover align-middle mb-0" style="font-size: 12.5px;">
                    <thead class="bg-danger text-white">
                        <tr>
                            <th class="p-2">Product Item</th>
                            <th class="p-2 text-center" style="width: 90px;">Sold Qty</th>
                            <th class="p-2 text-end" style="width: 150px;">Process Return</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(function(item) { %>
                        <tr>
                            <td class="p-2">
                                <span class="fw-bold text-dark d-block"><%= item.name %></span>
                            </td>
                            <td class="p-2 text-center fw-bold"><%= Number(item.qty).toFixed(3) %></td>
                            <td class="p-2 text-end">
                                <form action="/return_item" method="POST" class="d-flex gap-1 justify-content-end" onsubmit="return confirm('Confirm Return item? This adjusts shelf inventory.');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="bill_id" value="<%= sale_id %>">
                                    <input type="hidden" name="sale_id" value="<%= item.sale_id %>">
                                    <input type="hidden" name="product_id" value="<%= item.product_id %>">
                                    
                                    <input type="number" 
                                           name="return_qty" 
                                           class="form-control form-control-sm text-center fw-bold text-danger border-danger" 
                                           step="0.001" 
                                           min="0.001" 
                                           max="<%= item.qty %>" 
                                           placeholder="Qty" 
                                           required 
                                           style="width: 75px; border-radius: 6px;">
                                    <button type="submit" class="btn btn-danger btn-sm fw-bold px-2" style="border-radius: 6px;">↩️</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <% } %>
</div>

<script>
    // 1. Convert Number to English Words
    const totalAmount = Number("<%= total %>");
    const wordsEl = document.getElementById('word-display');
    if (wordsEl) {
        wordsEl.innerText = numToWords(Math.floor(totalAmount)) + " RUPEES ONLY";
    }

    // 2. Print Function & Return to Counter
    function printAndNext() {
        window.print();
        setTimeout(function(){
            window.location.href = '/sell';
        }, 1200);
    }

    // 3. Hotkeys for Thermal Bill View
    document.addEventListener('keydown', function(event) {
        if (event.key === "F1" || event.key === "Enter") {
            event.preventDefault();
            printAndNext();
        }
        if (event.key === "Escape") {
            event.preventDefault();
            window.location.href = '/sell';
        }
    });

    // 4. Auto-print trigger for fresh bills (not search history)
    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const isSearch = urlParams.has('bill_id');
        if (!isSearch) {
            window.print();
        }
    });
</script>

<%- include('footer') %>
