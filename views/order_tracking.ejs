<%- include('header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <!-- Breadcrumbs -->
      <nav aria-label="breadcrumb" class="mb-4 no-print">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/" class="text-decoration-none" style="color: var(--brand-green);">Home</a></li>
          <li class="breadcrumb-item active" aria-current="page">Track Order</li>
        </ol>
      </nav>

      <!-- Tracking Search Header -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius: 18px; overflow: hidden; border: 1px solid var(--sf-border) !important;">
        <div class="p-4 p-md-5 text-white text-center position-relative" style="background: linear-gradient(135deg, var(--brand-green), #031c10);">
          <span class="badge rounded-pill mb-2 px-3 py-1" style="background: var(--brand-gold); color: var(--brand-green-dark); font-size: 0.75rem; letter-spacing: 0.08em;">LIVE ORDER TRACKING</span>
          <h2 class="brand-font mb-2 text-white">Track Your Delivery</h2>
          <p class="text-white-50 max-w-600 mx-auto mb-4" style="font-size: 0.95rem;">
            Enter your Order Number and Registered Phone Number to view live order preparation, packing, and dispatch progress.
          </p>

          <form action="/track" method="POST" class="row g-2 justify-content-center mx-auto text-start" style="max-width: 680px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="col-12 col-md-5">
              <label class="form-label text-white-50 small mb-1" for="orderNumberInput">Order Number</label>
              <input type="text" 
                     id="orderNumberInput" 
                     name="orderNumber" 
                     class="form-control py-2 px-3" 
                     placeholder="e.g. STDF-2026-0001" 
                     value="<%= orderNumber || '' %>" 
                     required
                     style="border-radius: 10px; font-weight: 600;">
            </div>

            <div class="col-12 col-md-4">
              <label class="form-label text-white-50 small mb-1" for="phoneInput">Registered Phone</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border-radius: 10px 0 0 10px; font-weight: 600; color: #555;">+91</span>
                <input type="tel" 
                       id="phoneInput" 
                       name="phone" 
                       class="form-control py-2 px-3 border-start-0" 
                       placeholder="10-digit phone" 
                       value="<%= phone || '' %>" 
                       pattern="[0-9]{10}"
                       required
                       style="border-radius: 0 10px 10px 0; font-weight: 600;">
              </div>
            </div>

            <div class="col-12 col-md-3 d-flex align-items-end">
              <button type="submit" class="btn w-100 py-2 fw-bold" style="background: var(--brand-gold); color: var(--brand-green-dark); border-radius: 10px;">
                🔍 Track Now
              </button>
            </div>
          </form>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 p-3 mb-4" style="border-radius: 14px;">
          <span class="fs-4">⚠️</span>
          <div>
            <strong class="d-block text-dark">Lookup Failed</strong>
            <span class="small text-muted"><%= error %></span>
          </div>
        </div>
      <% } %>

      <% if (order) { 
          // Status order determination
          const statusOrder = ['NEW', 'CONFIRMED', 'PACKING', 'READY', 'DISPATCHED', 'COMPLETED'];
          const currentIdx = statusOrder.indexOf(order.status);
          const isCancelled = order.status === 'CANCELLED';
      %>
        <!-- Order Overview Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 18px; border: 1px solid var(--sf-border) !important;">
          <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-bottom pb-3 mb-4">
              <div>
                <span class="text-muted small d-block">Tracking Reference</span>
                <h4 class="brand-font m-0" style="color: var(--brand-green);">Order #<%= order.order_number %></h4>
                <small class="text-muted">Placed on <%= new Date(order.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
              </div>
              <div class="text-md-end">
                <span class="badge px-3 py-2 fs-6 rounded-pill" 
                      style="background: <%= isCancelled ? '#dc3545' : (order.status === 'COMPLETED' ? '#198754' : 'var(--brand-gold)') %>; 
                             color: <%= isCancelled || order.status === 'COMPLETED' ? '#ffffff' : 'var(--brand-green-dark)' %>;">
                  ● <%= isCancelled ? 'CANCELLED' : order.status %>
                </span>
                <div class="fw-bold fs-5 mt-1" style="color: var(--brand-green-light);">₹<%= Number(order.total_amount).toFixed(2) %></div>
              </div>
            </div>

            <!-- Visual 5-Stage Stepper -->
            <% if (!isCancelled) { %>
            <div class="order-stepper-wrapper mb-5 pt-2">
              <h6 class="fw-bold mb-3 text-muted small text-uppercase" style="letter-spacing: 0.08em;">Live Fulfillment Progress</h6>
              <div class="order-stepper d-flex justify-content-between position-relative">
                <div class="stepper-line" style="position: absolute; top: 20px; left: 5%; right: 5%; height: 4px; background: #E2E8F0; z-index: 1;">
                  <div class="stepper-line-progress" style="height: 100%; background: var(--brand-green); width: <%= Math.min(100, Math.max(0, (currentIdx / 4) * 100)) %>%; transition: width 0.5s ease;"></div>
                </div>

                <!-- Step 1: Placed -->
                <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
                  <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                       style="width: 40px; height: 40px; background: <%= currentIdx >= 0 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 0 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 0 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                    <%= currentIdx > 0 ? '✓' : '1' %>
                  </div>
                  <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Placed</small>
                  <span class="text-muted" style="font-size: 0.68rem;">Order Received</span>
                </div>

                <!-- Step 2: Confirmed -->
                <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
                  <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                       style="width: 40px; height: 40px; background: <%= currentIdx >= 1 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 1 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 1 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                    <%= currentIdx > 1 ? '✓' : '2' %>
                  </div>
                  <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Confirmed</small>
                  <span class="text-muted" style="font-size: 0.68rem;">Verified by Store</span>
                </div>

                <!-- Step 3: Packing -->
                <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
                  <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                       style="width: 40px; height: 40px; background: <%= currentIdx >= 2 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 2 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 2 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                    <%= currentIdx > 2 ? '✓' : '3' %>
                  </div>
                  <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Packing</small>
                  <span class="text-muted" style="font-size: 0.68rem;">Hygiene Packed</span>
                </div>

                <!-- Step 4: Dispatched / Ready -->
                <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
                  <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                       style="width: 40px; height: 40px; background: <%= currentIdx >= 3 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 3 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 3 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                    <%= currentIdx > 4 ? '✓' : '4' %>
                  </div>
                  <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;"><%= order.delivery_type === 'STORE_PICKUP' ? 'Ready for Pickup' : 'Dispatched' %></small>
                  <span class="text-muted" style="font-size: 0.68rem;"><%= order.delivery_type === 'STORE_PICKUP' ? 'In Store' : 'Out for Delivery' %></span>
                </div>

                <!-- Step 5: Completed -->
                <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
                  <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                       style="width: 40px; height: 40px; background: <%= currentIdx >= 5 ? '#198754' : '#ffffff' %>; color: <%= currentIdx >= 5 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 5 ? '#198754' : '#CBD5E1' %>;">
                    <%= currentIdx >= 5 ? '✓' : '5' %>
                  </div>
                  <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Delivered</small>
                  <span class="text-muted" style="font-size: 0.68rem;">Order Complete</span>
                </div>
              </div>
            </div>
            <% } else { %>
              <div class="alert alert-danger py-3 mb-4 rounded-3">
                <strong>This order was cancelled.</strong> For questions regarding refund or status, please contact support via WhatsApp.
              </div>
            <% } %>

            <!-- Order Details & Items Grid -->
            <div class="row g-4">
              <div class="col-md-7">
                <div class="border rounded-3 p-3 bg-white h-100">
                  <h6 class="fw-bold mb-3 border-bottom pb-2">Ordered Items (<%= items.length %>)</h6>
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <thead class="table-light small">
                        <tr>
                          <th>Item</th>
                          <th class="text-center">Qty</th>
                          <th class="text-end">Amount</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% items.forEach(function(item) { %>
                          <tr>
                            <td class="py-2">
                              <span class="fw-semibold text-dark"><%= item.product_name %></span>
                              <div class="small text-muted">₹<%= Number(item.unit_price).toFixed(2) %> each</div>
                            </td>
                            <td class="text-center py-2 fw-bold">× <%= item.quantity %></td>
                            <td class="text-end py-2 fw-bold text-dark">₹<%= Number(item.total_price).toFixed(2) %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                      <tfoot class="border-top">
                        <tr>
                          <td colspan="2" class="text-end text-muted small pt-2">Subtotal:</td>
                          <td class="text-end small pt-2">₹<%= Number(order.subtotal).toFixed(2) %></td>
                        </tr>
                        <tr>
                          <td colspan="2" class="text-end text-muted small">Delivery:</td>
                          <td class="text-end small"><%= order.delivery_charge > 0 ? '₹' + Number(order.delivery_charge).toFixed(2) : 'FREE' %></td>
                        </tr>
                        <% if (order.discount > 0) { %>
                        <tr>
                          <td colspan="2" class="text-end text-success small">Discount:</td>
                          <td class="text-end text-success small">-₹<%= Number(order.discount).toFixed(2) %></td>
                        </tr>
                        <% } %>
                        <tr class="fw-bold fs-6">
                          <td colspan="2" class="text-end pt-2" style="color: var(--brand-green);">Total:</td>
                          <td class="text-end pt-2" style="color: var(--brand-green);">₹<%= Number(order.total_amount).toFixed(2) %></td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              </div>

              <div class="col-md-5">
                <div class="border rounded-3 p-3 bg-light h-100 d-flex flex-column justify-content-between">
                  <div>
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Fulfillment Details</h6>
                    
                    <div class="mb-3">
                      <small class="text-muted d-block">Delivery Mode</small>
                      <strong><%= order.delivery_type === 'DELIVERY' ? '🚚 Home Delivery (Tekkali)' : '🏬 Store Pickup (Tekkali Store)' %></strong>
                    </div>

                    <div class="mb-3">
                      <small class="text-muted d-block">Payment Method</small>
                      <strong><%= order.payment_mode === 'COD' ? '💵 Cash on Delivery (COD)' : (order.payment_mode === 'UPI_QR' ? '📲 UPI QR at Delivery' : order.payment_mode) %></strong>
                    </div>

                    <% if (order.notes) { %>
                    <div class="mb-3">
                      <small class="text-muted d-block">Customer Instructions</small>
                      <span class="small font-monospace"><%= order.notes %></span>
                    </div>
                    <% } %>

                    <!-- Timeline Status Log -->
                    <% if (statusLogs && statusLogs.length > 0) { %>
                    <div class="mt-3">
                      <small class="text-muted d-block mb-2 fw-bold">Status History</small>
                      <ul class="list-unstyled mb-0 small ps-2 border-start border-2 border-success">
                        <% statusLogs.forEach(function(log) { %>
                          <li class="mb-2 ps-2 position-relative">
                            <strong><%= log.new_status %></strong>
                            <span class="text-muted d-block" style="font-size: 0.72rem;">
                              <%= new Date(log.timestamp).toLocaleString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                              <% if (log.changed_by) { %> • <%= log.changed_by %><% } %>
                            </span>
                          </li>
                        <% }); %>
                      </ul>
                    </div>
                    <% } %>
                  </div>

                  <!-- WhatsApp Direct Inquiry -->
                  <div class="mt-4 pt-3 border-top">
                    <a href="https://wa.me/919133133931?text=<%= encodeURIComponent('Hi Sri Tirumala Dry Fruits, I am checking the status of my order ' + order.order_number) %>" 
                       target="_blank" 
                       rel="noopener"
                       class="btn btn-success w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2"
                       style="border-radius: 10px;">
                      <span>💬 Chat with Store on WhatsApp</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      <% } else if (!error) { %>
        <!-- Default State: How tracking works -->
        <div class="row g-4 mt-2">
          <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100 text-center" style="border-radius: 16px;">
              <div class="fs-1 mb-2">📱</div>
              <h6 class="fw-bold">1. Order Confirmation</h6>
              <p class="text-muted small m-0">When your order is created, you receive an automated confirmation with an order ID.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100 text-center" style="border-radius: 16px;">
              <div class="fs-1 mb-2">🌿</div>
              <h6 class="fw-bold">2. Packing & Prep</h6>
              <p class="text-muted small m-0">Our Tekkali team hand-packs your wholesome dry fruits in sealed, climate-safe pouches.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100 text-center" style="border-radius: 16px;">
              <div class="fs-1 mb-2">🛵</div>
              <h6 class="fw-bold">3. Local Dispatch</h6>
              <p class="text-muted small m-0">Our express delivery partner brings fresh nutritious snacks right to your doorstep.</p>
            </div>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('footer') %>
