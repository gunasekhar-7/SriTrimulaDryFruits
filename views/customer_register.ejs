<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Customer Register - Sri Tirumala Dryfruits</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="/storefront.css">
  <style>
    body {
      background-color: var(--sf-cream);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .auth-card {
      border-radius: 20px;
      border: 1px solid var(--sf-border);
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(6, 58, 34, 0.08);
      overflow: hidden;
    }
    .auth-header {
      background: linear-gradient(135deg, var(--sf-primary), #031c10);
      color: white;
      padding: 30px 24px;
      text-align: center;
      border-bottom: 3px solid var(--sf-gold);
    }
  </style>
</head>
<body>

  <!-- Minimal Brand Header -->
  <header class="py-3 border-bottom bg-white">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
        <span class="material-symbols-outlined" style="font-size: 2rem; color: #2D5A27;">spa</span>
        <div>
          <strong class="d-block text-dark brand-title" style="font-size: 1.15rem; color: var(--sf-primary) !important;">Sri Tirumala</strong>
          <small class="d-block text-muted" style="font-size: 0.65rem; letter-spacing: 0.15em;">TEKKALI STORE</small>
        </div>
      </a>
      <a href="/" class="btn btn-outline-secondary btn-sm" style="border-radius: 20px;">
        ← Back to Store
      </a>
    </div>
  </header>

  <main class="container my-auto py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        
        <div class="auth-card">
          <div class="auth-header">
            <span class="material-symbols-outlined d-block mb-1" style="font-size: 2.5rem; color: #D89A4E;">person_add</span>
            <h3 class="brand-font m-0 text-white">Create an Account</h3>
            <p class="text-white-50 small m-0 mt-1">Join Sri Tirumala for fast checkout &amp; exclusive offers</p>
          </div>

          <div class="p-4 p-md-5">
            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
              <div class="alert alert-danger d-flex align-items-center gap-2 border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
                <span class="material-symbols-outlined" style="font-size: 1.25rem;">warning</span>
                <span class="small fw-semibold"><%= error %></span>
              </div>
            <% } %>

            <form action="/customer/register" method="POST" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- Name Field -->
              <div class="mb-3">
                <label for="regName" class="form-label fw-semibold small text-muted">Full Name</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px;">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem; color: #64748B;">person</span>
                  </span>
                  <input type="text" 
                         id="regName" 
                         name="name" 
                         class="form-control border-start-0 py-2" 
                         placeholder="Enter your name" 
                         required 
                         autocomplete="name"
                         style="border-radius: 0 10px 10px 0;">
                </div>
              </div>

              <!-- Phone Field -->
              <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="regPhone" class="form-label fw-semibold small text-muted m-0">Phone Number (10 digits)</label>
                  <button type="button" id="btnSendOtp" class="btn btn-sm btn-outline-success py-0 px-2 fw-semibold" style="font-size: 0.75rem; border-radius: 6px;">
                    Send Code
                  </button>
                </div>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px; font-weight: 600; color: #555;">+91</span>
                  <input type="tel" 
                         id="regPhone" 
                         name="phone" 
                         class="form-control border-start-0 py-2" 
                         pattern="[6-9]\d{9}" 
                         placeholder="9876543210" 
                         title="Enter a valid 10-digit Indian phone number" 
                         required 
                         autocomplete="tel"
                         style="border-radius: 0 10px 10px 0;">
                </div>
                <div id="otpStatus" class="form-text small mt-1 text-muted" style="min-height: 1.2rem;"></div>
              </div>

              <!-- Verification Code (OTP) -->
              <div class="mb-3" id="otpGroup">
                <label for="regOtp" class="form-label fw-semibold small text-muted">Verification Code (OTP)</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px;">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem; color: #64748B;">key</span>
                  </span>
                  <input type="text" 
                         id="regOtp" 
                         name="otp" 
                         class="form-control border-start-0 py-2" 
                         placeholder="6-digit verification code" 
                         maxlength="6"
                         autocomplete="one-time-code"
                         style="border-radius: 0 10px 10px 0;">
                </div>
                <div class="form-text small text-muted">
                  Required if you have placed previous orders with this phone number.
                </div>
              </div>

              <!-- Email Field -->
              <div class="mb-3">
                <label for="regEmail" class="form-label fw-semibold small text-muted">Email Address</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px;">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem; color: #64748B;">mail</span>
                  </span>
                  <input type="email" 
                         id="regEmail" 
                         name="email" 
                         class="form-control border-start-0 py-2" 
                         placeholder="name@example.com" 
                         required 
                         autocomplete="email"
                         style="border-radius: 0 10px 10px 0;">
                </div>
              </div>

              <!-- Password Field with Toggle -->
              <div class="mb-4">
                <label for="regPassword" class="form-label fw-semibold small text-muted">Password (min 6 characters)</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px;">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem; color: #64748B;">lock</span>
                  </span>
                  <input type="password" 
                         id="regPassword" 
                         name="password" 
                         class="form-control border-start-0 border-end-0 py-2" 
                         placeholder="Create a strong password" 
                         required 
                         minlength="6"
                         autocomplete="new-password">
                  <button type="button" 
                          class="btn btn-outline-secondary border-start-0 d-flex align-items-center justify-content-center" 
                          onclick="togglePasswordVisibility('regPassword', this)"
                          aria-label="Show password"
                          style="border-radius: 0 10px 10px 0;">
                    <span class="material-symbols-outlined" style="font-size: 1.15rem;">visibility</span>
                  </button>
                </div>
              </div>

              <button type="submit" class="btn btn-brand w-100 py-3 fw-bold fs-6 shadow-sm mb-3" style="border-radius: 12px;">
                Complete Registration →
              </button>
            </form>

            <div class="text-center pt-3 border-top">
              <span class="text-muted small">Already registered?</span>
              <a href="/customer/login" class="fw-bold d-block mt-1" style="color: var(--sf-primary-light);">
                Log In to Your Account
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </main>

  <footer class="py-3 text-center text-muted small mt-auto border-top bg-white">
    © 2026 Sri Tirumala Dryfruits &bull; Tekkali, AP
  </footer>

  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1.15rem;">visibility_off</span>';
        btn.setAttribute('aria-label', 'Hide password');
      } else {
        input.type = 'password';
        btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1.15rem;">visibility</span>';
        btn.setAttribute('aria-label', 'Show password');
      }
    }

    const btnSendOtp = document.getElementById('btnSendOtp');
    const regPhone = document.getElementById('regPhone');
    const otpStatus = document.getElementById('otpStatus');
    const csrfToken = '<%= csrfToken %>';

    let countdownTimer = null;

    if (btnSendOtp) {
      btnSendOtp.addEventListener('click', async () => {
        const phone = (regPhone.value || '').trim();
        if (!/^[6-9]\d{9}$/.test(phone)) {
          otpStatus.className = 'form-text small mt-1 text-danger';
          otpStatus.innerText = 'Please enter a valid 10-digit mobile number first.';
          regPhone.focus();
          return;
        }

        btnSendOtp.disabled = true;
        otpStatus.className = 'form-text small mt-1 text-muted';
        otpStatus.innerText = 'Sending verification code...';

        try {
          const res = await fetch('/customer/send-otp', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'CSRF-Token': csrfToken
            },
            body: JSON.stringify({ phone, purpose: 'REGISTRATION', _csrf: csrfToken })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            otpStatus.className = 'form-text small mt-1 text-success';
            otpStatus.innerText = data.message;
            startCooldown(data.cooldownSeconds || 60);
          } else {
            otpStatus.className = 'form-text small mt-1 text-danger';
            otpStatus.innerText = data.message || 'Failed to send verification code.';
            btnSendOtp.disabled = false;
          }
        } catch (err) {
          otpStatus.className = 'form-text small mt-1 text-danger';
          otpStatus.innerText = 'Network error. Please try again.';
          btnSendOtp.disabled = false;
        }
      });
    }

    function startCooldown(seconds) {
      let remaining = seconds;
      btnSendOtp.disabled = true;
      btnSendOtp.innerText = `Resend in ${remaining}s`;

      if (countdownTimer) clearInterval(countdownTimer);
      countdownTimer = setInterval(() => {
        remaining -= 1;
        if (remaining <= 0) {
          clearInterval(countdownTimer);
          btnSendOtp.disabled = false;
          btnSendOtp.innerText = 'Resend Code';
        } else {
          btnSendOtp.innerText = `Resend in ${remaining}s`;
        }
      }, 1000);
    }
  </script>
</body>
</html>
