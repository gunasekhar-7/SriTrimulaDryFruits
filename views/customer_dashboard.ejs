<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Customer Dashboard - Sri Tirumala Dryfruits</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="/storefront.css">
  <style>
    body {
      background-color: var(--sf-cream);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .dash-box {
      border-radius: 16px;
      border: 1px solid var(--sf-border);
      background: #ffffff;
      box-shadow: 0 4px 16px rgba(6, 58, 34, 0.05);
      transition: var(--sf-transition);
    }
    .dash-box:hover {
      transform: translateY(-4px);
      box-shadow: var(--sf-shadow-md);
    }
  </style>
</head>
<body>
  <%- include('partials/header_account') %>

  <div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="brand-font mb-1" style="color: var(--brand-green);">Welcome, <%= customer.name %>!</h3>
        <p class="text-muted small m-0">Manage your Sri Tirumala customer account</p>
      </div>
      <a href="/" class="btn btn-brand btn-sm px-3 py-2 fw-bold d-inline-flex align-items-center gap-1" style="border-radius: 20px;">
        <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">shopping_bag</span> Shop Catalog
      </a>
    </div>

    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="dash-box p-4 text-center h-100 d-flex flex-column">
          <span class="material-symbols-outlined d-block mb-3" style="font-size: 2.5rem; color: #2D5A27;">inventory_2</span>
          <h5 class="fw-bold text-dark">My Orders</h5>
          <p class="text-muted small">View recent orders, track fulfillment status and invoices.</p>
          <a href="/account/orders" class="btn btn-outline-success mt-auto fw-bold" style="border-radius: 10px;">
            View Orders →
          </a>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3">
        <div class="dash-box p-4 text-center h-100 d-flex flex-column">
          <span class="material-symbols-outlined d-block mb-3" style="font-size: 2.5rem; color: #B86A28;">favorite</span>
          <h5 class="fw-bold text-dark">Saved Wishlist</h5>
          <p class="text-muted small">Access saved favorites and move directly to your active cart.</p>
          <a href="/account/wishlist" class="btn btn-outline-success mt-auto fw-bold" style="border-radius: 10px;">
            Open Wishlist →
          </a>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="dash-box p-4 text-center h-100 d-flex flex-column">
          <span class="material-symbols-outlined d-block mb-3" style="font-size: 2.5rem; color: #D89A4E;">location_on</span>
          <h5 class="fw-bold text-dark">Saved Addresses</h5>
          <p class="text-muted small">Manage home delivery addresses for 1-click checkout.</p>
          <a href="/account/addresses" class="btn btn-outline-success mt-auto fw-bold" style="border-radius: 10px;">
            Manage Addresses →
          </a>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="dash-box p-4 text-center h-100 d-flex flex-column">
          <span class="material-symbols-outlined d-block mb-3" style="font-size: 2.5rem; color: #2D5A27;">badge</span>
          <h5 class="fw-bold text-dark">Personal Profile</h5>
          <p class="text-muted small">Update your registered phone number, email and name.</p>
          <a href="/account/profile" class="btn btn-outline-success mt-auto fw-bold" style="border-radius: 10px;">
            Edit Profile →
          </a>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
