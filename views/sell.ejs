<%- include('header') %>

<div class="pos-terminal-wrapper">
    <!-- ==============================================================================
         1. TOP CASHIER HEADER & SHIFT STATUS BANNER (Stitch)
         ============================================================================== -->
    <div class="pos-shift-banner d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Shift Status Banner -->
            <span class="pos-shift-status-pill">
                <span class="status-indicator-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #10B981; display: inline-block;"></span>
                <span>Shift #<%= (locals.currentShift && currentShift.id) ? currentShift.id : '101' %> Open</span>
                <span class="mx-1 opacity-50">•</span>
                <span>Float: ₹<%= (locals.currentShift && currentShift.opening_cash) ? Number(currentShift.opening_cash).toLocaleString('en-IN') : '5,000' %></span>
            </span>

            <!-- Active Cashier User Badge -->
            <span class="pos-cashier-badge">
                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.05rem;">person</span> Cashier: <strong><%= session.user %></strong></span>
                <span class="badge bg-light text-dark border ms-1" style="font-size: 10px;"><%= session.role ? session.role.toUpperCase() : 'STAFF' %></span>
            </span>

            <!-- Station ID -->
            <span class="d-none d-md-inline-flex align-items-center gap-1 text-muted small" style="font-size: 0.78rem;">
                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1rem;">desktop_windows</span> Counter Desk #1 (Tekkali Main)</span>
            </span>
        </div>

        <!-- Quick Header Operations -->
        <div class="d-flex align-items-center gap-2">
            <!-- Convert Online Order to POS Button -->
            <button type="button" 
                    class="btn btn-outline-success btn-sm fw-bold d-flex align-items-center gap-1 px-3 py-2 shadow-sm"
                    style="border-radius: 8px; font-size: 0.8rem; background: #FFFFFF;"
                    onclick="openPickupOrdersModal()"
                    id="btnConvertOnlinePickup">
                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.05rem;">inventory_2</span> Convert Online Order to POS</span>
                <span class="badge bg-success rounded-pill ms-1" id="pickupBadge" style="display: none;">0</span>
            </button>

            <!-- Drawer Reconciliation Modal Trigger -->
            <button type="button" 
                    class="btn btn-outline-secondary btn-sm fw-bold d-flex align-items-center gap-1 px-3 py-2 shadow-sm"
                    style="border-radius: 8px; font-size: 0.8rem; background: #FFFFFF;"
                    onclick="openDrawerReconciliationModal()">
                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.05rem;">point_of_sale</span> Drawer Reconcile</span>
            </button>

            <!-- Hotkeys Quick Guide Button -->
            <button type="button" 
                    class="btn btn-light btn-sm fw-bold border px-3 py-2 text-dark shadow-sm d-flex align-items-center gap-1"
                    style="border-radius: 8px; font-size: 0.8rem;"
                    onclick="openHotkeysModal()">
                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.05rem;">keyboard</span> Hotkeys</span> <span class="shortcut-badge text-dark bg-secondary bg-opacity-25 ms-1">F1</span>
            </button>
        </div>
    </div>

    <!-- Error Alert Display -->
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center gap-2 mb-3" style="border-radius: 10px;">
        <span class="material-symbols-outlined text-danger fs-5">warning</span>
        <span class="fw-bold"><%= error %></span>
    </div>
    <% } %>

    <!-- ==============================================================================
         2. MAIN WORKSTATION LAYOUT (Dual Column POS Terminal)
         ============================================================================== -->
    <div class="row g-3">
        
        <!-- LEFT COLUMN: SCANNING DOCK, QUICK TILES & CART TABLE -->
        <div class="col-lg-8 col-xl-8">
            
            <!-- A. BARCODE SCANNING & SEARCH DOCK -->
            <div class="pos-workstation-card">
                <div class="pos-card-header">
                    <h5 class="pos-card-title">
                        <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.15rem; color: #D89A4E;">barcode_scanner</span> Fast Scanner &amp; Product Lookup</span>
                    </h5>
                    <span class="text-muted small">Scanner Mode: <strong>Active Buffer</strong></span>
                </div>
                
                <div class="pos-scanner-box">
                    <form method="post" action="/sell" id="billingForm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        
                        <div class="row g-2 align-items-end">
                            <!-- 1. Barcode Field -->
                            <div class="col-md-3">
                                <label class="pos-input-group-label" for="barcodeInput">Barcode (Scanner Auto-Buffer)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 border-success text-success fw-bold">|||</span>
                                    <input type="text" 
                                           name="barcode" 
                                           id="barcodeInput" 
                                           class="form-control pos-input-field pos-barcode-field border-start-0" 
                                           placeholder="Scan barcode..." 
                                           autofocus 
                                           autocomplete="off">
                                </div>
                            </div>

                            <!-- 2. Item Name & Autocomplete -->
                            <div class="col-md-5 autocomplete-wrapper position-relative">
                                <label class="pos-input-group-label" for="nameDisplay">Item Name / Auto-Search</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <span class="material-symbols-outlined" style="font-size: 1.1rem;">search</span>
                                    </span>
                                    <input type="text" 
                                           name="name" 
                                           id="nameDisplay" 
                                           class="form-control pos-input-field border-start-0" 
                                           placeholder="Type item or SKU to search..." 
                                           autocomplete="off">
                                </div>
                                <div id="autocompleteResults" class="autocomplete-results"></div>
                            </div>

                            <!-- 3. MRP Display -->
                            <div class="col-6 col-md-2">
                                <label class="pos-input-group-label">MRP (₹)</label>
                                <input type="number" 
                                       step="0.01" 
                                       name="mrp" 
                                       id="mrpDisplay" 
                                       class="form-control pos-input-field bg-light text-muted" 
                                       readonly 
                                       tabindex="-1">
                            </div>

                            <!-- 4. Selling Rate -->
                            <div class="col-6 col-md-2">
                                <label class="pos-input-group-label text-success">Rate (₹)</label>
                                <input type="number" 
                                       step="0.01" 
                                       name="price" 
                                       id="priceDisplay" 
                                       class="form-control pos-input-field text-success fw-bold" 
                                       placeholder="0.00">
                            </div>
                        </div>

                        <!-- Secondary Row: Stock, Quantity Stepper, and Add Action -->
                        <div class="row g-2 align-items-end mt-2">
                            <!-- Stock Status -->
                            <div class="col-4 col-md-3">
                                <label class="pos-input-group-label">Available Stock</label>
                                <input type="text" 
                                       id="stockDisplay" 
                                       class="form-control pos-input-field bg-light text-secondary small" 
                                       readonly 
                                       tabindex="-1"
                                       placeholder="0.000">
                            </div>

                            <!-- Quantity Stepper with Quick Presets -->
                            <div class="col-8 col-md-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="pos-input-group-label m-0" for="qtyInput">Quantity / Weight</label>
                                    <div class="d-flex gap-1">
                                        <span class="pos-preset-chip" onclick="setQtyPreset(0.250)">250g</span>
                                        <span class="pos-preset-chip" onclick="setQtyPreset(0.500)">500g</span>
                                        <span class="pos-preset-chip" onclick="setQtyPreset(1.000)">1kg</span>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <button type="button" class="pos-stepper-btn" onclick="stepQuantity(-1)">−</button>
                                    <input type="number" 
                                           step="0.001" 
                                           name="qty" 
                                           id="qtyInput" 
                                           class="form-control pos-input-field text-center fw-bold" 
                                           value="1" 
                                           min="0.001">
                                    <button type="button" class="pos-stepper-btn" onclick="stepQuantity(1)">+</button>
                                </div>
                            </div>

                            <!-- Add Button -->
                            <div class="col-12 col-md-5">
                                <button type="submit" 
                                        class="btn btn-success w-100 fw-bold py-2 shadow-sm text-uppercase d-flex align-items-center justify-content-center gap-2" 
                                        id="btnAddItem"
                                        style="border-radius: 8px; height: 42px; background: #052E16; color: #FAF8F5; border-color: #052E16;">
                                    <span>⬇️ Add Item to Bill</span>
                                    <span class="shortcut-badge text-light bg-black bg-opacity-25">Enter</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- B. QUICK-TAP PRODUCT TILES (High Velocity Store Favorites) -->
                <div class="pos-card-header" style="background: #F8FAFC; border-top: 1px solid #E2E8F0;">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <span class="pos-input-group-label m-0 text-dark d-inline-flex align-items-center gap-1">
                            <span class="material-symbols-outlined text-warning" style="font-size: 1.1rem;">bolt</span> Quick-Tap Counter Tiles (One-Click Select)
                        </span>
                        <small class="text-muted" style="font-size: 0.72rem;">Click tile to populate buffer</small>
                    </div>
                </div>
                <div class="pos-quick-tiles-grid" id="quickTilesContainer">
                    <!-- Tile 1: California Almonds -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Almonds Premium', '1001', 850, 999, 45)">
                        <div class="pos-tile-name">Almonds Premium</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹850</span>
                            <span class="pos-tile-stock">Stock: 45</span>
                        </div>
                    </div>

                    <!-- Tile 2: Cashews W210 -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Cashews W210', '1002', 950, 1100, 38)">
                        <div class="pos-tile-name">Cashews W210</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹950</span>
                            <span class="pos-tile-stock">Stock: 38</span>
                        </div>
                    </div>

                    <!-- Tile 3: Royal Mamra Almonds -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Royal Mamra Almonds', '1034', 1450, 1700, 24)">
                        <div class="pos-tile-name">Mamra Almonds</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹1,450</span>
                            <span class="pos-tile-stock">Stock: 24</span>
                        </div>
                    </div>

                    <!-- Tile 4: Kashmiri Mongra Saffron -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Pure Kashmiri Mongra Saffron', '1010', 1199, 1350, 18)">
                        <div class="pos-tile-name">Mongra Saffron</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹1,199</span>
                            <span class="pos-tile-stock">Stock: 18</span>
                        </div>
                    </div>

                    <!-- Tile 5: Medjool Royal Dates -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Original Medjool Dates', '1006', 1650, 1890, 30)">
                        <div class="pos-tile-name">Medjool Dates</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹1,650</span>
                            <span class="pos-tile-stock">Stock: 30</span>
                        </div>
                    </div>

                    <!-- Tile 6: Akhrot Walnuts -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Walnuts Akhrot', '1005', 1050, 1250, 22)">
                        <div class="pos-tile-name">Walnuts Akhrot</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹1,050</span>
                            <span class="pos-tile-stock">Stock: 22</span>
                        </div>
                    </div>

                    <!-- Tile 7: Roasted Pistachios -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Pistachios Roasted', '1003', 1100, 1300, 28)">
                        <div class="pos-tile-name">Salted Pistachios</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹1,100</span>
                            <span class="pos-tile-stock">Stock: 28</span>
                        </div>
                    </div>

                    <!-- Tile 8: Wholesome Millets -->
                    <div class="pos-quick-tile" onclick="quickSelectTile('Organic Foxtail Millet', '1012', 180, 220, 50)">
                        <div class="pos-tile-name">Foxtail Millet</div>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="pos-tile-price">₹180</span>
                            <span class="pos-tile-stock">Stock: 50</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- C. ACTIVE POS REGISTER CART TABLE -->
            <div class="pos-workstation-card">
                <div class="pos-card-header d-flex justify-content-between align-items-center">
                    <h5 class="pos-card-title">
                        <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.15rem; color: #D89A4E;">receipt_long</span> Active Bill Items (<%= cart ? cart.length : 0 %>)</span>
                    </h5>
                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.75rem;">
                        Subtotal: ₹<%= Number(total).toFixed(2) %>
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="pos-cart-table table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 45px;">#</th>
                                <th>Item Description</th>
                                <th style="width: 100px;">MRP</th>
                                <th style="width: 110px;">Rate</th>
                                <th class="text-center" style="width: 140px;">Quantity</th>
                                <th class="text-end" style="width: 130px;">Line Total</th>
                                <th class="text-center" style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (cart && cart.length > 0) { %>
                                <% cart.forEach(function(item, index) { %>
                                <tr>
                                    <td class="text-center text-muted fw-bold"><%= index + 1 %></td>
                                    <td>
                                        <span class="fw-bold text-dark d-block" style="font-size: 0.95rem;"><%= item.name %></span>
                                        <small class="text-muted font-monospace" style="font-size: 0.72rem;">Code: <%= item.barcode %></small>
                                    </td>
                                    <td class="text-muted">
                                        <small><s>₹<%= Number(item.mrp || item.price || 0).toFixed(2) %></s></small>
                                    </td>
                                    <td class="fw-bold text-dark">₹<%= Number(item.price || 0).toFixed(2) %></td>
                                    <td class="text-center">
                                        <form action="/update_cart/<%= index %>" method="POST" class="d-inline-flex align-items-center justify-content-center gap-1">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="number" 
                                                   name="qty" 
                                                   value="<%= item.qty %>" 
                                                   step="0.001"
                                                   class="form-control pos-input-field text-center p-1 fw-bold" 
                                                   style="width: 80px; height: 34px; font-size: 0.88rem;"
                                                   onchange="this.form.submit()">
                                        </form>
                                    </td>
                                    <td class="text-end fw-bold text-success fs-6">
                                        ₹<%= Number(item.total || 0).toFixed(2) %>
                                    </td>
                                    <td class="text-center">
                                        <form action="/delete_item/<%= index %>" method="POST" style="display:inline;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger border-0 rounded-circle py-1 px-2 d-inline-flex align-items-center justify-content-center" 
                                                    title="Remove item" 
                                                    onclick="return confirm('Remove <%= item.name %> from current bill?')">
                                                <span class="material-symbols-outlined" style="font-size: 1.1rem; line-height: 1;">close</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <% if (!cart || cart.length === 0) { %>
                    <div class="text-center py-5 px-3 bg-white">
                        <span class="material-symbols-outlined fs-1 d-block mb-2 text-muted">shopping_cart</span>
                        <h6 class="fw-bold text-dark mb-1">POS Register Cart is Empty</h6>
                        <p class="text-muted small mb-0">Scan barcode, type an item name above, or tap any quick product tile to begin.</p>
                    </div>
                <% } %>
            </div>

            <!-- D. HELD / SUSPENDED BILLS SECTION -->
            <% if (typeof held_bills !== 'undefined' && held_bills && held_bills.length > 0) { %>
            <div class="pos-workstation-card">
                <div class="pos-card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined" style="font-size: 1.15rem;">pause_circle</span>
                        <span>Suspended Receipts On Hold</span>
                    </span>
                    <span class="badge bg-white text-dark rounded-pill px-2 py-1"><%= held_bills.length %></span>
                </div>
                <ul class="list-group list-group-flush">
                    <% held_bills.forEach(function(bill, index) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                        <div>
                            <strong class="d-block text-dark">₹<%= Number(bill.total || 0).toFixed(2) %></strong>
                            <small class="text-muted font-monospace d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                <span class="material-symbols-outlined" style="font-size: 0.9rem;">schedule</span> Suspended at: <%= bill.time %>
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <form action="/resume_bill/<%= index %>" method="POST" style="display:inline;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-primary py-1 px-3 fw-bold" style="border-radius: 6px; font-size: 0.78rem;">Resume</button>
                            </form>
                            <form action="/discard_held/<%= index %>" method="POST" style="display:inline;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle d-inline-flex align-items-center justify-content-center" onclick="return confirm('Discard this suspended receipt?')" title="Discard">
                                    <span class="material-symbols-outlined" style="font-size: 1.1rem; line-height: 1;">close</span>
                                </button>
                            </form>
                        </div>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>
        </div>

        <!-- RIGHT COLUMN: ERGONOMIC CHECKOUT DOCK -->
        <div class="col-lg-4 col-xl-4">
            <form method="POST" action="/finalize_bill" id="checkoutForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="payment_method" id="selectedPaymentMethod" value="Cash">

                <div class="pos-checkout-dock">
                    <!-- 1. Gross Bill Amount Header -->
                    <div class="pos-bill-gross-hero">
                        <span class="pos-bill-gross-label">Gross Subtotal Amount</span>
                        <h2 class="pos-bill-gross-amount" id="grossTotalDisplay">
                            ₹<%= Number(total).toFixed(2) %>
                        </h2>
                    </div>

                    <!-- 2. Customer Details Card -->
                    <div class="checkout-input-group mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-white small d-flex align-items-center gap-1" style="letter-spacing: 0.05em;">
                                <span class="material-symbols-outlined" style="font-size: 1rem;">badge</span> CUSTOMER DETAILS
                            </span>
                            <small class="text-white-50" style="font-size: 0.72rem;">Optional for Walk-in</small>
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-white-50 small m-0 mb-1" style="font-size: 0.72rem;">Customer Name</label>
                            <input type="text" 
                                   name="customer_name" 
                                   id="customerNameInput" 
                                   class="form-control form-control-sm checkout-field" 
                                   placeholder="e.g. Ramesh Kumar"
                                   value="<%= typeof customer_name !== 'undefined' ? customer_name : '' %>">
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-white-50 small m-0 mb-1" style="font-size: 0.72rem;">Phone Number (Digital Receipt &amp; Loyalty)</label>
                            <input type="tel" 
                                   name="customer_phone" 
                                   id="customerPhoneInput" 
                                   class="form-control form-control-sm checkout-field" 
                                   placeholder="e.g. 9876543210" 
                                   style="font-family: 'JetBrains Mono', monospace;"
                                   value="<%= typeof customer_phone !== 'undefined' ? customer_phone : '' %>">
                        </div>

                        <div class="mb-0">
                            <label class="form-label text-white-50 small m-0 mb-1" style="font-size: 0.72rem;">Manual Bill Discount (₹)</label>
                            <input type="number" 
                                   step="1" 
                                   name="discount_amount" 
                                   id="checkoutDiscount" 
                                   class="form-control form-control-sm checkout-field text-warning fw-bold fs-6" 
                                   placeholder="0" 
                                   value="0" 
                                   oninput="calculateNetTotal()">
                        </div>
                    </div>

                    <!-- 3. Payment Mode Selector (Cash, Dynamic UPI QR, Card) -->
                    <div class="mb-3">
                        <label class="form-label text-white-50 small m-0 mb-1" style="font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase;">
                            Select Payment Method
                        </label>
                        <div class="pos-payment-mode-grid">
                            <div class="pos-payment-btn active" id="payModeCash" onclick="setPaymentMode('Cash')">
                                <span class="material-symbols-outlined fs-5">payments</span>
                                <span>Cash</span>
                            </div>
                            <div class="pos-payment-btn" id="payModeUPI" onclick="setPaymentMode('UPI')">
                                <span class="material-symbols-outlined fs-5">qr_code_2</span>
                                <span>UPI QR</span>
                            </div>
                            <div class="pos-payment-btn" id="payModeCard" onclick="setPaymentMode('Card')">
                                <span class="material-symbols-outlined fs-5">credit_card</span>
                                <span>Card</span>
                            </div>
                        </div>

                        <!-- Dynamic UPI QR Display Box (Shows when UPI is active) -->
                        <div id="dynamicUpiBox" style="display: none; background: #FFFFFF; color: #052E16; border-radius: 10px; padding: 12px; text-align: center; margin-bottom: 12px;">
                            <span class="fw-bold d-block small mb-1">Scan &amp; Pay via PhonePe / GPay / Paytm</span>
                            <div id="upiQrTarget" class="d-flex justify-content-center py-1">
                                <img id="upiQrImage" src="" alt="Dynamic UPI QR" style="width: 140px; height: 140px; border: 1px solid #E2E8F0; border-radius: 6px;">
                            </div>
                            <small class="text-muted font-monospace d-block mt-1" style="font-size: 10px;">VPA: 9133133931@ybl • Sri Tirumala</small>
                        </div>
                    </div>

                    <!-- 4. 5% GST Tax Breakdown Box -->
                    <div class="pos-gst-box">
                        <div class="pos-gst-row">
                            <span>Taxable Base Value:</span>
                            <span id="taxableBaseDisplay">₹0.00</span>
                        </div>
                        <div class="pos-gst-row">
                            <span>CGST (2.5%):</span>
                            <span id="cgstDisplay">₹0.00</span>
                        </div>
                        <div class="pos-gst-row">
                            <span>SGST (2.5%):</span>
                            <span id="sgstDisplay">₹0.00</span>
                        </div>
                        <div class="pos-gst-row strong border-top border-white border-opacity-10 pt-1 mt-1">
                            <span>Total GST Included (5%):</span>
                            <span id="totalGstDisplay">₹0.00</span>
                        </div>
                    </div>

                    <!-- 5. Net Payable Display -->
                    <div class="d-flex justify-content-between align-items-baseline mb-2 border-top border-secondary border-opacity-50 pt-2">
                        <span class="text-white fw-bold fs-6">Net Payable:</span>
                        <span class="text-warning display-6 fw-extrabold" id="netPayDisplay" style="font-weight: 800;">
                            ₹<%= Number(total).toFixed(2) %>
                        </span>
                    </div>

                    <!-- 6. English Currency in Words Callout -->
                    <div class="pos-words-readout" id="posWordsReadout">
                        RUPEES IN WORDS: ZERO RUPEES ONLY
                    </div>

                    <!-- 7. POS Action Buttons -->
                    <div class="d-grid gap-2">
                        <button type="submit" 
                                id="btnCheckout" 
                                class="btn btn-warning btn-lg fw-bold text-dark py-3 shadow-lg d-flex align-items-center justify-content-center gap-2" 
                                style="border-radius: 10px; font-size: 1.05rem; letter-spacing: 0.04em;"
                                <%= (!cart || cart.length === 0) ? 'disabled' : '' %>>
                            <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1.25rem;">print</span> SETTLE &amp; PRINT RECEIPT</span>
                            <span class="shortcut-badge text-dark bg-white bg-opacity-25">F2</span>
                        </button>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" 
                                    id="btnHold" 
                                    formaction="/hold_bill" 
                                    class="btn btn-secondary flex-grow-1 py-2 fw-semibold d-flex align-items-center justify-content-center gap-1" 
                                    style="border-radius: 8px; font-size: 0.85rem;"
                                    <%= (!cart || cart.length === 0) ? 'disabled' : '' %>>
                                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1rem;">pause_circle</span> Hold Bill</span>
                                <span class="shortcut-badge">F3</span>
                            </button>

                            <button type="submit" 
                                    id="btnClear" 
                                    formaction="/clear_cart" 
                                    class="btn btn-outline-danger flex-grow-1 py-2 fw-semibold d-flex align-items-center justify-content-center gap-1" 
                                    onclick="return confirm('Clear entire active register bill?')" 
                                    style="border-radius: 8px; font-size: 0.85rem;"
                                    <%= (!cart || cart.length === 0) ? 'disabled' : '' %>>
                                <span class="d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 1rem;">delete_sweep</span> Clear</span>
                                <span class="shortcut-badge text-white" style="background: rgba(220,53,69,0.3);">F4</span>
                            </button>
                        </div>
                    </div>

                    <!-- 8. Keyboard Hotkeys Legend in Sidebar -->
                    <div class="mt-3 pt-2 border-top border-white border-opacity-10 text-white-50" style="font-size: 0.75rem;">
                        <div class="d-flex justify-content-between mb-1">
                            <span>F1: Hotkeys &amp; Help</span>
                            <span class="shortcut-badge">F1</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>F2: Finalize &amp; Print</span>
                            <span class="shortcut-badge">F2</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>F3: Hold / Suspend Receipt</span>
                            <span class="shortcut-badge">F3</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>F4: Clear Register / Search</span>
                            <span class="shortcut-badge">F4</span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

