<!-- ==============================================================================
     6. CLIENT-SIDE POS CONTROLLER ENGINE
     ============================================================================== -->
<script>
    const subtotalValue = Number("<%= total %>") || 0;
    let productsList = [];
    let activeIndex = -1;
    const nameInput = document.getElementById('nameDisplay');
    const resultsContainer = document.getElementById('autocompleteResults');

    // 1. Convert Number to English Words
    function numToWords(n) {
        const a = ['','One ','Two ','Three ','Four ', 'Five ','Six ','Seven ','Eight ','Nine ','Ten ','Eleven ','Twelve ','Thirteen ','Fourteen ','Fifteen ','Sixteen ','Seventeen ','Eighteen ','Nineteen '];
        const b = ['', '', 'Twenty','Thirty','Forty','Fifty', 'Sixty','Seventy','Eighty','Ninety'];
        if ((n = n.toString()).length > 9) return 'overflow';
        const match = ('000000000' + n).slice(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
        if (!match) return ''; 
        let str = '';
        str += (match[1] !== '00') ? (a[Number(match[1])] || b[match[1][0]] + ' ' + a[match[1][1]]) + 'Crore ' : '';
        str += (match[2] !== '00') ? (a[Number(match[2])] || b[match[2][0]] + ' ' + a[match[2][1]]) + 'Lakh ' : '';
        str += (match[3] !== '00') ? (a[Number(match[3])] || b[match[3][0]] + ' ' + a[match[3][1]]) + 'Thousand ' : '';
        str += (match[4] !== '0') ? (a[Number(match[4])] || b[match[4][0]] + ' ' + a[match[4][1]]) + 'Hundred ' : '';
        str += (match[5] !== '00') ? ((str !== '') ? 'and ' : '') + (a[Number(match[5])] || b[match[5][0]] + ' ' + a[match[5][1]]) + 'Only' : '';
        return str.trim();
    }

    // 2. Real-time Net Payable, 5% GST Breakdown & Currency Words Calculation
    function calculateNetTotal() {
        const discountInput = document.getElementById('checkoutDiscount');
        const netPayDisplay = document.getElementById('netPayDisplay');
        const posWordsReadout = document.getElementById('posWordsReadout');

        let discount = parseFloat(discountInput.value) || 0;
        if (discount < 0) {
            discount = 0;
            discountInput.value = 0;
        }

        const netTotal = Math.max(0, subtotalValue - discount);
        if (netPayDisplay) netPayDisplay.innerText = '₹' + netTotal.toFixed(2);

        // 5% GST Breakdown: Inclusive (Net = Base * 1.05)
        const taxableBase = netTotal / 1.05;
        const totalGst = netTotal - taxableBase;
        const halfGst = totalGst / 2;

        const baseEl = document.getElementById('taxableBaseDisplay');
        const cgstEl = document.getElementById('cgstDisplay');
        const sgstEl = document.getElementById('sgstDisplay');
        const totalGstEl = document.getElementById('totalGstDisplay');

        if (baseEl) baseEl.innerText = '₹' + taxableBase.toFixed(2);
        if (cgstEl) cgstEl.innerText = '₹' + halfGst.toFixed(2);
        if (sgstEl) sgstEl.innerText = '₹' + halfGst.toFixed(2);
        if (totalGstEl) totalGstEl.innerText = '₹' + totalGst.toFixed(2);

        // Words readout
        if (posWordsReadout) {
            const intVal = Math.floor(netTotal);
            posWordsReadout.innerText = 'RUPEES IN WORDS: ' + (intVal > 0 ? (numToWords(intVal) + ' RUPEES ONLY') : 'ZERO RUPEES ONLY');
        }

        // Update Dynamic UPI QR code if visible
        updateDynamicUpiQr(netTotal);
    }

    // 3. Payment Mode Switcher (Cash, Dynamic UPI QR, Card)
    window.setPaymentMode = function(mode) {
        document.getElementById('selectedPaymentMethod').value = mode;
        ['Cash', 'UPI', 'Card'].forEach(m => {
            const btn = document.getElementById('payMode' + m);
            if (btn) {
                if (m === mode) btn.classList.add('active');
                else btn.classList.remove('active');
            }
        });

        const upiBox = document.getElementById('dynamicUpiBox');
        if (upiBox) {
            if (mode === 'UPI') {
                upiBox.style.display = 'block';
                const discount = parseFloat(document.getElementById('checkoutDiscount').value) || 0;
                const netTotal = Math.max(0, subtotalValue - discount);
                updateDynamicUpiQr(netTotal);
            } else {
                upiBox.style.display = 'none';
            }
        }
    };

    function updateDynamicUpiQr(amount) {
        const qrImg = document.getElementById('upiQrImage');
        if (!qrImg) return;
        const vpa = '9133133931@ybl';
        const name = encodeURIComponent('Sri Tirumala Dry Fruits');
        const upiUrl = `upi://pay?pa=${vpa}&pn=${name}&am=${amount.toFixed(2)}&cu=INR`;
        qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${encodeURIComponent(upiUrl)}`;
    }

    // 4. Quantity Stepper & Presets
    window.stepQuantity = function(delta) {
        const qtyField = document.getElementById('qtyInput');
        if (!qtyField) return;
        let current = parseFloat(qtyField.value) || 1;
        current = Math.max(0.001, current + delta);
        qtyField.value = current;
    };

    window.setQtyPreset = function(preset) {
        const qtyField = document.getElementById('qtyInput');
        if (qtyField) qtyField.value = preset;
    };

    // 5. Quick-Tap Tile Handler
    window.quickSelectTile = function(name, barcode, price, mrp, stock) {
        document.getElementById('barcodeInput').value = barcode;
        document.getElementById('nameDisplay').value = name;
        document.getElementById('priceDisplay').value = Number(price).toFixed(2);
        document.getElementById('mrpDisplay').value = Number(mrp).toFixed(2);
        document.getElementById('stockDisplay').value = Number(stock).toFixed(3);

        const qtyField = document.getElementById('qtyInput');
        if (qtyField) {
            qtyField.value = "1";
            qtyField.focus();
            qtyField.select();
        }
    };

    // 6. Sub-millisecond Local In-Memory Cache Product Lookup
    fetch('/api/v1/products')
        .then(res => res.json())
        .then(resData => {
            if (resData.success && resData.data && resData.data.products) {
                productsList = resData.data.products;
            } else if (Array.isArray(resData)) {
                productsList = resData;
            }
        })
        .catch(err => console.warn('Local cache product preload:', err));

    function selectProduct(p) {
        document.getElementById('barcodeInput').value = p.barcode;
        nameInput.value = p.name;
        document.getElementById('mrpDisplay').value = (p.mrp || p.selling_price || 0).toFixed(2);
        document.getElementById('priceDisplay').value = (p.selling_price || 0).toFixed(2);
        document.getElementById('stockDisplay').value = (p.available || 0).toFixed(3);
        if (resultsContainer) resultsContainer.style.display = 'none';

        const qtyField = document.getElementById('qtyInput');
        qtyField.value = "1";
        qtyField.focus();
        qtyField.select();
    }

    function fetchProductData() {
        const barcode = (document.getElementById('barcodeInput').value || '').trim();
        if (!barcode) return;

        // 1. Sub-millisecond local in-memory cache lookup
        const cached = productsList.find(p => p.barcode === barcode);
        if (cached) {
            selectProduct(cached);
            return;
        }

        // 2. Fallback to API
        fetch(`/api/v1/products/${barcode}`)
            .then(res => res.json())
            .then(resData => {
                if (resData.success && resData.data && resData.data.product) {
                    selectProduct(resData.data.product);
                } else {
                    alert('Product Barcode not found: ' + barcode);
                    document.getElementById('barcodeInput').value = '';
                }
            })
            .catch(err => console.error('Product lookup error:', err));
    }

    // Barcode Scanner Enter Key Listener
    document.getElementById('barcodeInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            fetchProductData();
        }
    });

    // 7. Autocomplete Item Search
    nameInput.addEventListener('input', function() {
        const query = this.value.toUpperCase().trim();
        if (!resultsContainer) return;
        resultsContainer.innerHTML = '';
        activeIndex = -1;

        if (!query) {
            resultsContainer.style.display = 'none';
            return;
        }

        const matches = productsList.filter(p => 
            p.name.toUpperCase().includes(query) || (p.barcode && p.barcode.includes(query))
        );

        if (matches.length === 0) {
            resultsContainer.style.display = 'none';
            return;
        }

        matches.slice(0, 10).forEach((p, idx) => {
            const item = document.createElement('div');
            item.className = 'autocomplete-item';
            item.dataset.index = idx;
            item.innerHTML = `
                <div>
                    <strong class="d-block text-dark">${p.name}</strong>
                    <span class="text-muted small font-monospace">${p.barcode} | Stock: ${(p.available || 0).toFixed(3)}</span>
                </div>
                <div class="text-end">
                    <strong class="text-success d-block">₹${(p.selling_price || 0).toFixed(2)}</strong>
                    <span class="text-muted text-decoration-line-through small">₹${(p.mrp || 0).toFixed(2)}</span>
                </div>
            `;
            item.addEventListener('click', () => selectProduct(p));
            resultsContainer.appendChild(item);
        });

        resultsContainer.style.display = 'block';
    });

    nameInput.addEventListener('keydown', function(e) {
        const items = resultsContainer.getElementsByClassName('autocomplete-item');
        if (resultsContainer.style.display === 'none' || items.length === 0) return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            activeIndex = (activeIndex + 1) % items.length;
            updateSelection(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            activeIndex = (activeIndex - 1 + items.length) % items.length;
            updateSelection(items);
        } else if (e.key === 'Enter') {
            if (activeIndex > -1) {
                e.preventDefault();
                items[activeIndex].click();
            }
        } else if (e.key === 'Escape') {
            resultsContainer.style.display = 'none';
        }
    });

    function updateSelection(items) {
        for (let i = 0; i < items.length; i++) items[i].classList.remove('active');
        if (activeIndex > -1) {
            items[activeIndex].classList.add('active');
            items[activeIndex].scrollIntoView({ block: 'nearest' });
        }
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.autocomplete-wrapper')) {
            if (resultsContainer) resultsContainer.style.display = 'none';
        }
    });

    // 8. Modals: Convert Online Order to POS
    window.openPickupOrdersModal = function() {
        const modal = new bootstrap.Modal(document.getElementById('pickupOrdersModal'));
        modal.show();
        loadPendingPickupOrders();
    };

    function loadPendingPickupOrders() {
        const listEl = document.getElementById('pickupOrdersList');
        fetch('/api/v1/pos/pending-pickups')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.orders && data.orders.length > 0) {
                    listEl.innerHTML = '';
                    // Update badge
                    const badge = document.getElementById('pickupBadge');
                    if (badge) {
                        badge.innerText = data.orders.length;
                        badge.style.display = 'inline-block';
                    }

                    data.orders.forEach(order => {
                        const itemCard = document.createElement('div');
                        itemCard.className = 'card p-3 border shadow-sm bg-white';
                        itemCard.style.borderRadius = '10px';
                        itemCard.innerHTML = `
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="d-block text-dark fs-6">${order.order_number}</strong>
                                    <span class="text-muted small">Customer: <strong>${order.customer_name || 'Walkin'}</strong> (${order.customer_phone || 'No phone'})</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-warning text-dark mb-1 d-block">${order.status}</span>
                                    <strong class="text-success fs-5">₹${Number(order.total_amount).toFixed(2)}</strong>
                                </div>
                            </div>
                            <div class="text-muted small mb-3">
                                Items: ${order.items ? order.items.map(i => i.product_name + ' × ' + i.quantity).join(', ') : (order.itemsCount + ' items')}
                            </div>
                            <form action="/pos/load-order/${order.id}" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-success btn-sm w-100 fw-bold py-2 d-inline-flex align-items-center justify-content-center gap-1" style="border-radius: 8px;">
                                    <span class="material-symbols-outlined" style="font-size: 1.05rem;">download</span> Load into POS Cart &amp; Convert
                                </button>
                            </form>
                        `;
                        listEl.appendChild(itemCard);
                    });
                } else {
                    listEl.innerHTML = `
                        <div class="text-center py-4 text-muted bg-white rounded border">
                            <span class="material-symbols-outlined fs-2 d-block mb-1 text-success">check_circle</span>
                            <strong>No Pending Pickup Orders</strong>
                            <p class="small mb-0 mt-1">All online store pickup requests have been processed.</p>
                        </div>
                    `;
                }
            })
            .catch(err => {
                listEl.innerHTML = `<div class="alert alert-danger mb-0">Failed to load pickup orders: ${err.message}</div>`;
            });
    }

    // Check pickup orders count on load
    fetch('/api/v1/pos/pending-pickups')
        .then(res => res.json())
        .then(data => {
            if (data.success && data.orders && data.orders.length > 0) {
                const badge = document.getElementById('pickupBadge');
                if (badge) {
                    badge.innerText = data.orders.length;
                    badge.style.display = 'inline-block';
                }
            }
        })
        .catch(() => {});

    // 9. Modals: Drawer Reconciliation
    window.openDrawerReconciliationModal = function() {
        const modal = new bootstrap.Modal(document.getElementById('drawerReconciliationModal'));
        modal.show();
    };

    window.computeReconciliationVariance = function() {
        const input = document.getElementById('reconActualCashInput');
        const box = document.getElementById('reconVarianceBox');
        const text = document.getElementById('reconVarianceText');
        const expected = <%= (locals.currentShift && currentShift.opening_cash) ? Number(currentShift.opening_cash) : 5000 %>;

        const actual = parseFloat(input.value);
        if (isNaN(actual)) {
            box.style.display = 'none';
            return;
        }

        const variance = actual - expected;
        box.style.display = 'block';
        if (variance === 0) {
            box.className = 'alert alert-success py-2 small mb-0 text-center fw-bold';
            text.innerText = '₹0.00 (Balanced)';
        } else if (variance > 0) {
            box.className = 'alert alert-warning py-2 small mb-0 text-center fw-bold';
            text.innerText = '+₹' + variance.toFixed(2) + ' (Cash Overage)';
        } else {
            box.className = 'alert alert-danger py-2 small mb-0 text-center fw-bold';
            text.innerText = '-₹' + Math.abs(variance).toFixed(2) + ' (Cash Shortage)';
        }
    };

    // 10. Modals: Hotkeys Guide (F1)
    window.openHotkeysModal = function() {
        const modal = new bootstrap.Modal(document.getElementById('hotkeysModal'));
        modal.show();
    };

    // 11. Rapid Keyboard Shortcuts Engine
    document.addEventListener('keydown', function(e) {
        // F1: Help / Hotkeys Cheat Sheet
        if (e.key === 'F1') {
            e.preventDefault();
            openHotkeysModal();
            return;
        }

        // F2: Settle Bill & Finalize
        if (e.key === 'F2') {
            e.preventDefault();
            const btn = document.getElementById('btnCheckout');
            if (btn && !btn.disabled) {
                document.getElementById('checkoutForm').submit();
            }
            return;
        }

        // F3: Hold / Suspend Active Bill
        if (e.key === 'F3') {
            e.preventDefault();
            const btn = document.getElementById('btnHold');
            if (btn && !btn.disabled) btn.click();
            return;
        }

        // F4: Search Invoices or Clear Cart
        if (e.key === 'F4') {
            e.preventDefault();
            if (e.shiftKey) {
                window.location.href = '/search_bill';
            } else {
                const btn = document.getElementById('btnClear');
                if (btn && !btn.disabled) btn.click();
                else window.location.href = '/search_bill';
            }
            return;
        }

        // Escape: Dismiss active autocomplete or blur
        if (e.key === 'Escape') {
            if (resultsContainer) resultsContainer.style.display = 'none';
        }
    });

    // Double Submission Guard
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            if (submitBtn) {
                if (submitBtn.dataset.submitting === 'true') {
                    e.preventDefault();
                    return false;
                }
                submitBtn.dataset.submitting = 'true';
                submitBtn.classList.add('disabled');
            }
        });
    });

    // Initial calculation on page load
    window.addEventListener('DOMContentLoaded', () => {
        calculateNetTotal();
        const barcodeEl = document.getElementById('barcodeInput');
        if (barcodeEl) barcodeEl.focus();
    });
</script>

<%- include('footer') %>
