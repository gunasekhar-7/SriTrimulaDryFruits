<%- include('header') %>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card p-5 shadow-sm text-center border-0 bg-white" style="border-radius: 24px;">
            <div class="brand-logo mb-3" style="font-size: 2.5rem;">🔎</div>
            <h2 class="mb-2 brand-font text-success" style="color: var(--brand-green) !important;">Search Invoice</h2>
            <p class="text-muted small mb-4">Retrieve and print a historical invoice from the Sri Tirumala local system database.</p>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2 border-0 rounded-3 small fw-bold" role="alert">⚠️ <%= error %></div>
            <% } %>

            <form method="post" action="/search_bill">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-4 text-start">
                    <label class="form-label fw-bold text-muted small text-uppercase" style="letter-spacing: 0.05em;">Enter Bill / Invoice Number</label>
                    <input type="number" name="bill_id" class="form-control form-control-lg text-center fw-bold border-success py-3 text-success" placeholder="e.g. 101" required autofocus style="font-size: 1.5rem; letter-spacing: 0.05em; font-family: 'JetBrains Mono', monospace;">
                    <div class="form-text small text-muted text-center mt-2">Check the printed invoice header if you aren't sure of the code.</div>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold py-3 text-uppercase" style="letter-spacing: 0.05em; border-radius: 12px; font-size: 1rem;">
                    Find & Print Invoice 🖨️
                </button>
            </form>
            
            <div class="mt-4 border-top border-light pt-3">
                <a href="/sell" class="text-decoration-none text-muted small hover-link">&larr; Return to Billing Desk</a>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
