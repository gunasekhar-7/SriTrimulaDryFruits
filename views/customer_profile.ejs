<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Profile - Sri Tirumala Dryfruits</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/storefront.css">
  <style>
    body {
      background-color: var(--sf-cream);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .profile-card {
      border-radius: 16px;
      border: 1px solid var(--sf-border);
      background: #ffffff;
      box-shadow: 0 4px 16px rgba(6, 58, 34, 0.05);
    }
  </style>
</head>
<body>
  <%- include('partials/header_account') %>

  <div class="container mt-4 mb-5">
    <div class="row">
      <div class="col-md-3 mb-4 mb-md-0">
        <%- include('partials/account_nav', { currentPath: '/account/profile' }) %>
      </div>
      <div class="col-md-9">
        <div class="profile-card p-4">
          <h4 class="brand-font mb-1" style="color: var(--brand-green);">Profile Details</h4>
          <p class="text-muted small mb-4">Manage your personal contact information</p>

          <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <div class="alert alert-danger border-0 shadow-sm mb-4" style="border-radius: 12px;"><%= error %></div>
          <% } %>
          <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <div class="alert alert-success border-0 shadow-sm mb-4" style="border-radius: 12px;"><%= success %></div>
          <% } %>

          <form action="/account/profile" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted">Full Name</label>
              <input type="text" name="name" class="form-control py-2" value="<%= customer.name %>" required style="border-radius: 10px;">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted">Phone Number</label>
              <input type="text" name="phone" class="form-control py-2" value="<%= customer.phone %>" required pattern="[6-9]\d{9}" style="border-radius: 10px;">
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold small text-muted">Email Address</label>
              <input type="email" name="email" class="form-control py-2" value="<%= customer.email %>" required style="border-radius: 10px;">
            </div>
            <button type="submit" class="btn btn-brand px-4 py-2 fw-bold" style="border-radius: 10px;">
              💾 Save Changes
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
