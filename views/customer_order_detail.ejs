<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> - Sri Tirumala Dryfruits</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/storefront.css">
  <style>
    body {
      background-color: var(--sf-cream);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .order-card {
      border-radius: 16px;
      border: 1px solid var(--sf-border);
      background: #ffffff;
      box-shadow: 0 4px 16px rgba(6, 58, 34, 0.05);
    }
  </style>
</head>
<body>
  <%- include('partials/header_account') %>

  <div class="container mt-4 mb-5">
    <div class="row">
      <div class="col-md-3 mb-4 mb-md-0">
        <%- include('partials/account_nav', { currentPath: '/account/orders' }) %>
      </div>
      
      <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <a href="/account/orders" class="btn btn-outline-secondary btn-sm" style="border-radius: 20px;">
            <i class="fas fa-arrow-left me-1"></i> Back to Orders
          </a>
          <h4 class="brand-font mb-0" style="color: var(--brand-green);">Order #<%= order.order_number %></h4>
        </div>
        
        <!-- Summary Strip -->
        <div class="order-card p-4 mb-4">
          <div class="row text-center text-md-start g-3">
            <div class="col-6 col-md-3">
              <span class="text-muted d-block small">Order Date</span>
              <strong class="text-dark"><%= new Date(order.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
            </div>
            <div class="col-6 col-md-3">
              <span class="text-muted d-block small">Total Amount</span>
              <strong class="fs-5" style="color: var(--brand-green-light);">₹<%= Number(order.total_amount).toFixed(2) %></strong>
            </div>
            <div class="col-6 col-md-3">
              <span class="text-muted d-block small">Fulfillment</span>
              <strong class="text-dark"><%= order.delivery_type === 'DELIVERY' ? '🚚 Home Delivery' : '🏬 Store Pickup' %></strong>
            </div>
            <div class="col-6 col-md-3">
              <span class="text-muted d-block small">Payment Mode</span>
              <strong class="text-dark"><%= order.payment_mode === 'COD' ? '💵 Cash on Delivery' : (order.payment_mode === 'UPI_QR' ? '📲 UPI QR' : order.payment_mode) %></strong>
            </div>
          </div>
        </div>

        <!-- Visual 5-Stage Stepper -->
        <% 
          const statusOrder = ['NEW', 'CONFIRMED', 'PACKING', 'READY', 'DISPATCHED', 'COMPLETED'];
          const currentIdx = statusOrder.indexOf(order.status);
          const isCancelled = order.status === 'CANCELLED';
        %>
        <% if (!isCancelled) { %>
        <div class="order-card p-4 mb-4">
          <h6 class="fw-bold mb-4 text-muted small text-uppercase" style="letter-spacing: 0.08em;">Live Fulfillment Progress</h6>
          
          <div class="order-stepper d-flex justify-content-between position-relative pb-2">
            <div class="stepper-line" style="position: absolute; top: 18px; left: 6%; right: 6%; height: 4px; background: #E2E8F0; z-index: 1;">
              <div class="stepper-line-progress" style="height: 100%; background: var(--brand-green); width: <%= Math.min(100, Math.max(0, (currentIdx / 4) * 100)) %>%; transition: width 0.5s ease;"></div>
            </div>

            <!-- Step 1: Placed -->
            <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
              <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                   style="width: 36px; height: 36px; background: <%= currentIdx >= 0 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 0 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 0 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                <%= currentIdx > 0 ? '✓' : '1' %>
              </div>
              <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Placed</small>
            </div>

            <!-- Step 2: Confirmed -->
            <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
              <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                   style="width: 36px; height: 36px; background: <%= currentIdx >= 1 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 1 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 1 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                <%= currentIdx > 1 ? '✓' : '2' %>
              </div>
              <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Confirmed</small>
            </div>

            <!-- Step 3: Packing -->
            <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
              <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                   style="width: 36px; height: 36px; background: <%= currentIdx >= 2 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 2 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 2 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                <%= currentIdx > 2 ? '✓' : '3' %>
              </div>
              <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Packing</small>
            </div>

            <!-- Step 4: Dispatched / Ready -->
            <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
              <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                   style="width: 36px; height: 36px; background: <%= currentIdx >= 3 ? 'var(--brand-green)' : '#ffffff' %>; color: <%= currentIdx >= 3 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 3 ? 'var(--brand-green)' : '#CBD5E1' %>;">
                <%= currentIdx > 4 ? '✓' : '4' %>
              </div>
              <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;"><%= order.delivery_type === 'STORE_PICKUP' ? 'Ready' : 'Dispatched' %></small>
            </div>

            <!-- Step 5: Completed -->
            <div class="step-node text-center position-relative" style="z-index: 2; width: 20%;">
              <div class="node-circle rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
                   style="width: 36px; height: 36px; background: <%= currentIdx >= 5 ? '#198754' : '#ffffff' %>; color: <%= currentIdx >= 5 ? '#ffffff' : '#94A3B8' %>; border: 3px solid <%= currentIdx >= 5 ? '#198754' : '#CBD5E1' %>;">
                <%= currentIdx >= 5 ? '✓' : '5' %>
              </div>
              <small class="d-block mt-2 fw-bold text-dark" style="font-size: 0.78rem;">Delivered</small>
            </div>
          </div>
        </div>
        <% } %>

        <div class="row g-4">
          <!-- Items List -->
          <div class="col-lg-8">
            <div class="order-card p-4">
              <h5 class="fw-bold mb-3 border-bottom pb-2">Items in this order (<%= items.length %>)</h5>
              <div class="table-responsive">
                <table class="table align-middle mb-0">
                  <thead class="table-light small">
                    <tr>
                      <th>Product</th>
                      <th class="text-center">Qty</th>
                      <th class="text-end">Total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% items.forEach(item => { %>
                      <tr>
                        <td class="py-2">
                          <div class="fw-bold text-dark"><%= item.product ? item.product.name : item.product_name %></div>
                          <div class="small text-muted">₹<%= Number(item.unit_price).toFixed(2) %> each</div>
                        </td>
                        <td class="text-center align-middle fw-bold">× <%= item.quantity %></td>
                        <td class="text-end align-middle fw-bold text-dark">₹<%= Number(item.total_price).toFixed(2) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                  <tfoot class="border-top">
                    <tr>
                      <td colspan="2" class="text-end text-muted small pt-2">Subtotal:</td>
                      <td class="text-end small pt-2">₹<%= Number(order.subtotal).toFixed(2) %></td>
                    </tr>
                    <tr>
                      <td colspan="2" class="text-end text-muted small">Delivery:</td>
                      <td class="text-end small"><%= order.delivery_charge > 0 ? '₹' + Number(order.delivery_charge).toFixed(2) : 'FREE' %></td>
                    </tr>
                    <tr class="fw-bold fs-6">
                      <td colspan="2" class="text-end pt-2" style="color: var(--brand-green);">Total Amount:</td>
                      <td class="text-end pt-2" style="color: var(--brand-green);">₹<%= Number(order.total_amount).toFixed(2) %></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>
          
          <!-- Status Sidebar & Support -->
          <div class="col-lg-4">
            <div class="order-card p-4 mb-4">
              <div class="text-center mb-3">
                <span class="badge px-3 py-2 fs-6 rounded-pill" 
                      style="background: <%= isCancelled ? '#dc3545' : (order.status === 'COMPLETED' ? '#198754' : 'var(--brand-gold)') %>; 
                             color: <%= isCancelled || order.status === 'COMPLETED' ? '#ffffff' : 'var(--brand-green-dark)' %>;">
                  ● <%= order.status %>
                </span>
              </div>
              
              <h6 class="border-bottom pb-2 fw-bold small text-muted text-uppercase">Timeline</h6>
              <div class="timeline mt-3" style="border-left: 2px solid #e9ecef; margin-left: 10px; padding-left: 15px;">
                <% statusLogs.forEach(log => { %>
                  <div class="timeline-item mb-3 position-relative">
                    <div class="position-absolute" style="left: -21px; top: 3px; width: 10px; height: 10px; border-radius: 50%; background: var(--brand-green);"></div>
                    <div class="fw-bold small"><%= log.new_status %></div>
                    <div class="text-muted" style="font-size: 0.72rem;"><%= new Date(log.timestamp).toLocaleString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
                  </div>
                <% }) %>
              </div>

              <div class="d-grid mt-4 pt-2 border-top">
                <a href="https://wa.me/919133133931?text=<%= encodeURIComponent('Hi Sri Tirumala Dry Fruits, I have a query about my order ' + order.order_number) %>" 
                   target="_blank" 
                   rel="noopener"
                   class="btn btn-success fw-bold d-flex align-items-center justify-content-center gap-2"
                   style="border-radius: 10px;">
                  <i class="fab fa-whatsapp"></i> Chat Support
                </a>
              </div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
