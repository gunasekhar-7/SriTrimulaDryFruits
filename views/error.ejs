<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= statusCode %> <%= title %> | Sri Tirumala</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --brand-green: #063A22; --brand-gold: #D4AF37; }
        body {
            background: linear-gradient(135deg, #032113, #063A22);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #fff;
        }
        .error-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(212,175,55,0.2);
            border-radius: 24px;
            padding: 60px 48px;
            text-align: center;
            max-width: 500px;
            width: 100%;
            backdrop-filter: blur(10px);
        }
        .error-code {
            font-family: 'Playfair Display', serif;
            font-size: 6rem;
            font-weight: 800;
            color: var(--brand-gold);
            line-height: 1;
            margin-bottom: 8px;
        }
        .error-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 12px; }
        .error-msg { color: rgba(255,255,255,0.65); margin-bottom: 32px; line-height: 1.6; }
        .btn-home {
            background: var(--brand-gold);
            color: #032113;
            font-weight: 700;
            border: none;
            padding: 13px 32px;
            border-radius: 12px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s;
        }
        .btn-home:hover { background: #e5c040; color: #032113; transform: translateY(-1px); }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="error-code"><%= statusCode %></div>
        <div class="error-title"><%= title %></div>
        <p class="error-msg"><%= message %></p>
        <a href="/" class="btn-home">← Go Back Home</a>
        <% if (statusCode === 500) { %>
        <a href="javascript:history.back()" class="btn-home ms-2" style="background: rgba(255,255,255,0.08); color:#fff; border: 1px solid rgba(255,255,255,0.15);">↩ Back</a>
        <% } %>
    </div>
</body>
</html>
