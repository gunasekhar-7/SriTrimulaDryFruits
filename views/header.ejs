<script>
    // Smooth toggle of address fields based on fulfillment choice
    function toggleAddressFields(isDelivery) {
        const wrapper = document.getElementById('addressSectionWrapper');
        const addrInput = document.getElementById('checkoutAddress');
        if (!wrapper || !addrInput) return;
        if (isDelivery) {
            wrapper.style.display = 'block';
            addrInput.setAttribute('required', 'required');
        } else {
            wrapper.style.display = 'none';
            addrInput.removeAttribute('required');
        }
    }
</script>

