<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %> - Sri Tirumala Dryfruits</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/storefront.css">
  <style>
    body {
      background-color: var(--sf-cream);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .order-card {
      border-radius: 16px;
      border: 1px solid var(--sf-border);
      background: #ffffff;
      box-shadow: 0 4px 16px rgba(6, 58, 34, 0.05);
      transition: var(--sf-transition);
    }
    .order-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--sf-shadow-md);
    }
  </style>
</head>
<body>
  <%- include('partials/header_account') %>

  <div class="container mt-4 mb-5">
    <div class="row">
      <div class="col-md-3 mb-4 mb-md-0">
        <%- include('partials/account_nav', { currentPath: '/account/orders' }) %>
      </div>
      
      <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="brand-font mb-0" style="color: var(--brand-green);">Order History</h4>
          <span class="badge bg-light text-muted border px-3 py-2"><%= orders.length %> Orders</span>
        </div>

        <% if (orders.length === 0) { %>
          <div class="text-center py-5 border rounded-3 bg-white shadow-sm" style="border-radius: 20px !important;">
            <span class="fs-1 d-block mb-3">📦</span>
            <h5 class="fw-bold text-dark">No orders placed yet</h5>
            <p class="text-muted small max-w-600 mx-auto mb-4">
              You haven't placed any orders with us yet. Explore our fresh, nutritious catalog of dry fruits and seeds.
            </p>
            <a href="/" class="btn btn-brand px-4 py-2 fw-bold" style="border-radius: 20px;">
              🛍️ Start Shopping
            </a>
          </div>
        <% } else { %>
          <div class="row g-3">
            <% orders.forEach(order => { 
                const isCancelled = order.status === 'CANCELLED';
                const isCompleted = order.status === 'COMPLETED';
            %>
              <div class="col-12">
                <div class="order-card p-3 p-md-4">
                  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom pb-3 mb-3">
                    <div>
                      <strong class="fs-5 text-dark">Order #<%= order.order_number %></strong>
                      <div class="text-muted small">Placed on <%= new Date(order.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
                    </div>
                    <div>
                      <span class="badge px-3 py-2 rounded-pill" 
                            style="background: <%= isCancelled ? '#dc3545' : (isCompleted ? '#198754' : 'var(--brand-gold)') %>; 
                                   color: <%= isCancelled || isCompleted ? '#ffffff' : 'var(--brand-green-dark)' %>;">
                        ● <%= order.status %>
                      </span>
                    </div>
                  </div>

                  <div class="row align-items-center g-3">
                    <div class="col-6 col-md-3">
                      <div class="text-muted small">Total Paid</div>
                      <div class="fs-5 fw-bold" style="color: var(--brand-green-light);">₹<%= Number(order.total_amount).toFixed(2) %></div>
                    </div>

                    <div class="col-6 col-md-4">
                      <div class="text-muted small">Fulfillment</div>
                      <div class="fw-semibold text-dark"><%= order.delivery_type === 'DELIVERY' ? '🚚 Home Delivery' : '🏬 Store Pickup' %></div>
                    </div>

                    <div class="col-12 col-md-5 d-flex gap-2">
                      <a href="/account/orders/<%= order.id %>" class="btn btn-outline-success btn-sm flex-grow-1 fw-bold py-2" style="border-radius: 10px;">
                        🔍 Track & Details
                      </a>
                      <a href="https://wa.me/919133133931?text=<%= encodeURIComponent('Hi Sri Tirumala Dry Fruits, I need assistance with order ' + order.order_number) %>" 
                         target="_blank" 
                         rel="noopener"
                         class="btn btn-success btn-sm px-3 py-2 fw-bold d-flex align-items-center gap-1" 
                         style="border-radius: 10px;">
                        <i class="fab fa-whatsapp"></i> Chat
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
