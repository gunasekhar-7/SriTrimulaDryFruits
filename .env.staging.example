# ==============================================================================
# SRI TIRUMALA DRY FRUITS - STAGING ENVIRONMENT CONFIGURATION (.env.staging)
# Purpose: Pre-production QA validation, realistic sanitized data, external sandbox APIs
# ==============================================================================

# Core Application Server
NODE_ENV=staging
PORT=3000
TZ=Asia/Kolkata
SITE_URL=https://staging.sritirumaladryfruits.com

# Security Secrets (Must be generated 64-char hex strings, stored in GitHub Staging Secrets)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_staging_64_char_cryptographic_hex_secret
COOKIE_SECRET=replace_with_staging_64_char_cryptographic_hex_secret

# WhatsApp Storefront Configuration (Staging QA Sandbox Phone)
STORE_WHATSAPP_PHONE=919133133931
FREE_DELIVERY_THRESHOLD=500
DELIVERY_CHARGE=50

# Meta WhatsApp Cloud API (Test Business App credentials)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_test_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_test_phone_number_id
WHATSAPP_VERIFY_TOKEN=replace_with_meta_test_verify_token
WHATSAPP_APP_SECRET=replace_with_meta_test_app_secret

# Staging Mail Relay (e.g. Mailtrap / SendGrid Sandbox)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace_with_mailtrap_user
SMTP_PASS=replace_with_mailtrap_pass

# Observability & Logging
LOG_LEVEL=info
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://staging-collector:4318
