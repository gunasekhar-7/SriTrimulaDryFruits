# ==============================================================================
# SRI TIRUMALA DRY FRUITS - DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.development)
# Purpose: Local developer workstation, hot-reloading with tsx, mock external APIs
# ==============================================================================

# Core Application Server
NODE_ENV=development
PORT=3000
TZ=Asia/Kolkata

# Security Secrets (Local development strings are acceptable locally)
SESSION_SECRET=dev_session_secret_local_workstation_testing_only_32_chars
COOKIE_SECRET=dev_cookie_secret_local_workstation_testing_only_32_chars

# WhatsApp Storefront Configuration (Local Test Sandbox)
STORE_WHATSAPP_PHONE=919133133931
FREE_DELIVERY_THRESHOLD=500
DELIVERY_CHARGE=50

# Meta WhatsApp Cloud API (Optional for dev: left empty triggers local mocks)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sritirumala_dev_verify_token
WHATSAPP_APP_SECRET=

# Local Mail Server Mock (e.g., MailHog / Mailpit on localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Observability & Logging
LOG_LEVEL=debug
OTEL_TRACES_ENABLED=false
